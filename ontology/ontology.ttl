@prefix : <http://vocab.linkeddata.es/datosabiertos/def/urbanismo-infraestructuras/alumbrado-publico#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix dc: <http://purl.org/dc/elements/1.1/> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix edintalu: <http://vocab.linkeddata.es/datosabiertos/def/urbanismo-infraestructuras/alumbrado-publico#> .
@prefix edintinf: <http://vocab.linkeddata.es/datosabiertos/def/urbanismo-infraestructuras/infraestructura#> .
@prefix edintkosinftype: <http://vocab.linkeddata.es/datosabiertos/kos/edint/InfrastructureType/> .
@prefix edintsum: <http://vocab.linkeddata.es/datosabiertos/def/urbanismo-infraestructuras/suministro#> .
@prefix esdir: <http://vocab.linkeddata.es/datosabiertos/def/urbanismo-infraestructuras/direccion-postal#> .
@prefix esadm: <http://vocab.linkeddata.es/datosabiertos/def/sector-publico/territorio#> .
@prefix gsp: <http://www.opengis.net/ont/geosparql#> .
@prefix schema: <http://schema.org/> .
@prefix vann: <http://purl.org/vocab/vann/> .
@prefix qudt: <http://qudt.org/schema/qudt/> .
@prefix qudtu: <http://qudt.org/vocab/unit/> .
@prefix sosa: <http://www.w3.org/ns/sosa/> .

# ============================================================
# ONTOLOGY HEADER
# ============================================================

<http://vocab.linkeddata.es/datosabiertos/def/urbanismo-infraestructuras/alumbrado-publico> a owl:Ontology ;
    owl:versionIRI <http://vocab.linkeddata.es/datosabiertos/def/urbanismo-infraestructuras/alumbrado-publico/0.1.0> ;
    owl:versionInfo "0.1.0" ;
    dc:title "Ontología de Alumbrado Público"@es , "Public Street Lighting Ontology"@en ;
    dc:abstract "Ontología para la representación de datos de alumbrado público. Modela la composición modular de farolas, la infraestructura eléctrica, el consumo energético y los parámetros fotométricos y de contaminación lumínica."@es ;
    dc:abstract "Ontology for representing public street lighting data. Models the modular composition of streetlights, electrical infrastructure, energy consumption, and photometric and light pollution parameters."@en ;
    dc:description "Ontología para la representación de datos de alumbrado público en el contexto de la FEMP. Modela: composición modular de farolas (poste, luminaria, lámpara, caja), infraestructura eléctrica (centro de mando), consumo energético como observación SOSA con resultado QUDT, catálogo de modelos de luminaria, fabricante, parámetros fotométricos y de contaminación lumínica (FHS, zonas E1-E4), y estado de conservación. Unidades de medida con QUDT."@es ;
    dc:description "Ontology for representing public street lighting data in the context of FEMP (Spanish Federation of Municipalities and Provinces). Models: modular composition of streetlights (post, luminaire, lamp, box), electrical infrastructure (control center), energy consumption as SOSA observation with QUDT result, luminaire model catalog, manufacturer, photometric parameters and light pollution (FHS, zones E1-E4), and conservation status. Measurement units with QUDT."@en ;
    rdfs:label "Ontología de Alumbrado Público"@es , "Public Street Lighting Ontology"@en ;
    rdfs:comment "Ontología para la representación de datos de alumbrado público."@es ;
    rdfs:comment "Ontology for representing public street lighting data."@en ;
    dc:creator "María Poveda" , "M. Martín Blázquez" , "Oscar Corcho" ,
              "Daniel Doña" , "Edna Ruckhaus" , "Lucía Sánchez" ;
    dc:contributor "Ontology Engineering Group, Universidad Politécnica de Madrid" ;
    dc:publisher "FEMP — Federación Española de Municipios y Provincias" ;
    dcterms:license <https://creativecommons.org/licenses/by/4.0/> ;
    dcterms:created "2026-05-07"^^xsd:date ;
    vann:preferredNamespacePrefix "edintalu" ;
    vann:preferredNamespaceUri "http://vocab.linkeddata.es/datosabiertos/def/urbanismo-infraestructuras/alumbrado-publico#" ;
    rdfs:seeAlso <https://github.com/opencitydata/urbanismo-infraestructuras-alumbrado-publico> ;
    owl:imports <http://www.w3.org/2004/02/skos/core> ;
    owl:priorVersion <https://raw.githubusercontent.com/opencitydata/urbanismo-infraestructuras-alumbrado-publico/main/v1.0-rc/ontology/ontology.owl> .

# ============================================================
# ANNOTATION PROPERTIES
# ============================================================

dc:abstract rdf:type owl:AnnotationProperty .
dc:description rdf:type owl:AnnotationProperty .
dc:creator rdf:type owl:AnnotationProperty .
dc:contributor rdf:type owl:AnnotationProperty .
dc:publisher rdf:type owl:AnnotationProperty .
vann:preferredNamespacePrefix rdf:type owl:AnnotationProperty .
vann:preferredNamespaceUri rdf:type owl:AnnotationProperty .

# ============================================================
# CLASSES
# ============================================================

# --- Clases reutilizadas ---

esdir:DireccionPostal a owl:Class ;
    rdfs:label "Dirección postal"@es , "Postal address"@en ;
    rdfs:comment "Dirección postal en España. Especialización de schema:PostalAddress, vcard:Address y locn:Address. Permite representar la dirección de una farola con propiedades como streetAddress, addressLocality, postalCode, etc."@es ;
    rdfs:comment "Postal address in Spain. Specialisation of schema:PostalAddress, vcard:Address and locn:Address. Allows representing a streetlight's address with properties like streetAddress, addressLocality, postalCode, etc."@en ;
    rdfs:isDefinedBy <http://vocab.linkeddata.es/datosabiertos/def/urbanismo-infraestructuras/direccion-postal> .

# --- Core: composición de Farola ---

edintalu:Farola a owl:Class ;
    rdfs:subClassOf edintinf:UrbanElement ;
    rdfs:subClassOf [ a owl:Restriction ;
                      owl:onProperty edintinf:hasInfrastructureType ;
                      owl:hasValue edintkosinftype:StreeLamp ] ;
    rdfs:label "Farola"@es , "Streetlight"@en ;
    rdfs:comment "Punto de luz completo, compuesto por un poste, una o más luminarias (que a su vez contienen lámparas) y opcionalmente una caja de conexiones. Es un elemento urbano (edintinf:UrbanElement) y, por herencia, un InfrastructureElement que puede tener punto de suministro (edintsum:hasUtilitySupplyPoint). Toda instancia de Farola tiene como tipo de infraestructura 'Street lamp' (edintkosinftype:StreeLamp) del SKOS de EDINT."@es ;
    rdfs:comment "A complete point of light, composed of a post, one or more luminaires (which in turn contain lamps) and optionally a junction box. It is an urban element (edintinf:UrbanElement) and, by inheritance, an InfrastructureElement that can have a utility supply point (edintsum:hasUtilitySupplyPoint). Every instance of Farola has infrastructure type 'Street lamp' (edintkosinftype:StreeLamp) from the EDINT SKOS."@en .

edintalu:Poste a owl:Class ;
    rdfs:label "Poste"@es , "Post"@en ;
    rdfs:comment "Soporte físico de la farola: columna, báculo, fachada, postelete, etc. El tipo concreto se indica mediante tipoSoporte (SKOS). Un poste puede tener uno o más brazos."@es ;
    rdfs:comment "Physical support of the streetlight: column, bracket, wall, short post, etc. The specific type is indicated via tipoSoporte (SKOS). A post can have one or more arms."@en .

edintalu:Brazo a owl:Class ;
    rdfs:label "Brazo"@es , "Arm"@en ;
    rdfs:comment "Brazo del poste que soporta una luminaria. Un poste puede tener múltiples brazos, cada uno con su propia altura."@es ;
    rdfs:comment "Arm of the post that supports a luminaire. A post can have multiple arms, each with its own height."@en .

edintalu:Luminaria a owl:Class ;
    rdfs:label "Luminaria"@es , "Luminaire"@en ;
    rdfs:comment "Aparato de iluminación que aloja, dirige y filtra la luz de la lámpara. Una farola puede tener múltiples luminarias (caso LED+DESCARGA). Puede referenciar un modelo del catálogo (ModeloLuminaria)."@es ;
    rdfs:comment "Lighting apparatus that houses, directs and filters the light from the lamp. A streetlight can have multiple luminaires (e.g., LED+DISCHARGE). Can reference a catalog model (ModeloLuminaria)."@en .

edintalu:Lampara a owl:Class ;
    rdfs:label "Lámpara"@es , "Lamp"@en ;
    rdfs:comment "Fuente de luz: bombilla, módulo LED o convertidor de energía eléctrica en luz. Cada luminaria aloja exactamente una lámpara. Incluye propiedades fotométricas (potencia, flujo, CCT, CRI) y de vida útil (L70, L80)."@es ;
    rdfs:comment "Light source: bulb, LED module or converter of electrical energy into light. Each luminaire houses exactly one lamp. Includes photometric properties (power, luminous flux, CCT, CRI) and rated life (L70, L80)."@en .

edintalu:Caja a owl:Class ;
    rdfs:label "Caja"@es , "Junction Box"@en ;
    rdfs:comment "Caja de conexiones o registro de acceso a los cables eléctricos de la farola. Opcional: no todas las farolas tienen una caja accesible."@es ;
    rdfs:comment "Junction box or access point for the streetlight's electrical cables. Optional: not all streetlights have an accessible box."@en .

# --- Infraestructura eléctrica ---

edintalu:CentroDeMando a owl:Class ;
    rdfs:subClassOf edintsum:UtilitySupplyPoint ;
    rdfs:label "Centro de mando"@es , "Control Center"@en ;
    rdfs:comment "Cuadro eléctrico o centro de control del que dependen una o más farolas. Es un punto de suministro (edintsum:UtilitySupplyPoint), punto donde llega la electricidad a la instalación de alumbrado."@es ;
    rdfs:comment "Electrical panel or control center on which one or more streetlights depend. It is a utility supply point (edintsum:UtilitySupplyPoint), the point where electricity reaches the lighting installation."@en .



# --- Energía ---

edintalu:SuministroElectrico a owl:Class ;
    rdfs:subClassOf edintsum:UtilityContract ;
    rdfs:label "Suministro eléctrico"@es , "Electricity Supply"@en ;
    rdfs:comment "Contrato de suministro eléctrico asociado a un centro de mando. Incluye tarifa, tensión y consumo por períodos tarifarios. Es un contrato de suministro (edintsum:UtilityContract), con tarifa y punto de suministro asociado."@es ;
    rdfs:comment "Electricity supply contract associated with a control center. Includes tariff, voltage, and consumption by tariff periods. It is a utility contract (edintsum:UtilityContract), with rate and associated supply point."@en .

edintalu:ConsumoEnergetico a owl:Class ;
    rdfs:subClassOf edintsum:UtilityConsumption ;
    rdfs:label "Consumo energético"@es , "Energy Consumption"@en ;
    rdfs:comment "Observación de consumo eléctrico en un período tarifario determinado. Al heredar de edintsum:UtilityConsumption ⊂ sosa:Observation, usa el patrón SOSA: – sosa:hasFeatureOfInterest → el CentroDeMando (punto de suministro) – sosa:observedProperty → edintsum:electricityConsumption – sosa:hasResult → qudt:QuantityValue (qudt:numericValue + qudt:hasUnit) – edintalu:periodoTarifario → concepto SKOS (activo, llano, valle, punta) Cada instancia representa el consumo en UN período tarifario. El total se obtiene sumando las instancias del mismo ejercicio."@es ;
    rdfs:comment "Observation of electricity consumption in a specific tariff period. By inheriting from edintsum:UtilityConsumption ⊂ sosa:Observation, uses the SOSA pattern: – sosa:hasFeatureOfInterest → the CentroDeMando (supply point) – sosa:observedProperty → edintsum:electricityConsumption – sosa:hasResult → qudt:QuantityValue (qudt:numericValue + qudt:hasUnit) – edintalu:periodoTarifario → SKOS concept (active, standard, off-peak, peak) Each instance represents consumption in ONE tariff period. The total is obtained by summing instances of the same fiscal year."@en .

edintalu:ReductorFlujo a owl:Class ;
    rdfs:label "Reductor de flujo"@es , "Flow Reducer"@en ;
    rdfs:comment "Sistema de ahorro energético que reduce el flujo luminoso. Puede estar ubicado en la luminaria (regulador de lámpara) o al inicio de la instalación (regulador de cabecera)."@es ;
    rdfs:comment "Energy saving system that reduces luminous flux. Can be located in the luminaire (lamp regulator) or at the start of the installation (head-end regulator)."@en .

# --- Catálogo y titularidad ---

edintalu:ModeloLuminaria a owl:Class ;
    rdfs:label "Modelo de luminaria"@es , "Luminaire Model"@en ;
    rdfs:comment "Entrada del catálogo de modelos de luminaria. Permite vincular fabricante, potencia nominal, tecnología y especificaciones fotométricas."@es ;
    rdfs:comment "Entry in the luminaire model catalog. Allows linking manufacturer, nominal power, technology and photometric specifications."@en .

edintalu:Fabricante a owl:Class ;
    rdfs:label "Fabricante"@es , "Manufacturer"@en ;
    rdfs:comment "Entidad que fabrica componentes del alumbrado (postes, luminarias, lámparas, cajas o modelos)."@es ;
    rdfs:comment "Entity that manufactures street lighting components (posts, luminaires, lamps, boxes or models)."@en .



# ============================================================
# OBJECT PROPERTIES
# ============================================================

# --- Composición de Farola ---

edintalu:poste a owl:ObjectProperty ;
    rdfs:domain edintalu:Farola ;
    rdfs:range edintalu:Poste ;
    rdfs:label "poste"@es , "post"@en ;
    rdfs:comment "Soporte físico de la farola. Cardinalidad: exactamente 1."@es ;
    rdfs:comment "Physical support of the streetlight. Cardinality: exactly 1."@en .

edintalu:luminaria a owl:ObjectProperty ;
    rdfs:domain edintalu:Farola ;
    rdfs:range edintalu:Luminaria ;
    rdfs:label "luminaria"@es , "luminaire"@en ;
    rdfs:comment "Aparato de iluminación de la farola. Cardinalidad: 1 o más (caso LED+DESCARGA)."@es ;
    rdfs:comment "Lighting apparatus of the streetlight. Cardinality: 1 or more (e.g., LED+DISCHARGE)."@en .

edintalu:caja a owl:ObjectProperty ;
    rdfs:domain edintalu:Farola ;
    rdfs:range edintalu:Caja ;
    rdfs:label "caja"@es , "junction box"@en ;
    rdfs:comment "Caja de conexiones de la farola. Cardinalidad: 0..1 (opcional)."@es ;
    rdfs:comment "Junction box of the streetlight. Cardinality: 0..1 (optional)."@en .

edintalu:tieneLampara a owl:ObjectProperty ;
    rdfs:domain edintalu:Luminaria ;
    rdfs:range edintalu:Lampara ;
    rdfs:label "tiene lámpara"@es , "has lamp"@en ;
    rdfs:comment "Lámpara alojada en la luminaria. Cardinalidad: exactamente 1."@es ;
    rdfs:comment "Lamp housed in the luminaire. Cardinality: exactly 1."@en .

# --- Infraestructura eléctrica ---

edintalu:centroDeMando a owl:ObjectProperty ;
    rdfs:domain edintalu:Farola ;
    rdfs:range edintalu:CentroDeMando ;
    rdfs:label "centro de mando"@es , "control center"@en ;
    rdfs:comment "Centro de mando del que depende la farola."@es ;
    rdfs:comment "Control center on which the streetlight depends."@en .

edintalu:tieneSuministro a owl:ObjectProperty ;
    rdfs:domain edintalu:CentroDeMando ;
    rdfs:range edintalu:SuministroElectrico ;
    rdfs:label "tiene suministro"@es , "has supply"@en ;
    rdfs:comment "Contrato de suministro eléctrico asociado al centro de mando. Cardinalidad: 0..1."@es ;
    rdfs:comment "Electricity supply contract associated with the control center. Cardinality: 0..1."@en .

edintalu:tieneConsumo a owl:ObjectProperty ;
    rdfs:domain edintalu:SuministroElectrico ;
    rdfs:range edintalu:ConsumoEnergetico ;
    rdfs:label "tiene consumo"@es , "has consumption"@en ;
    rdfs:comment "Registro de consumo energético del suministro. Cardinalidad: 0..n."@es ;
    rdfs:comment "Energy consumption record of the supply. Cardinality: 0..n."@en .

# --- Catálogo y fabricación ---

edintalu:modeloLuminaria a owl:ObjectProperty ;
    rdfs:domain edintalu:Luminaria ;
    rdfs:range edintalu:ModeloLuminaria ;
    rdfs:label "modelo de luminaria"@es , "luminaire model"@en ;
    rdfs:comment "Referencia al modelo de catálogo de la luminaria. Cardinalidad: 0..1."@es ;
    rdfs:comment "Reference to the luminaire's catalog model. Cardinality: 0..1."@en .

edintalu:fabricadoPor a owl:ObjectProperty ;
    rdfs:range edintalu:Fabricante ;
    rdfs:label "fabricado por"@es , "manufactured by"@en ;
    rdfs:comment "Fabricante del componente. Aplica a: Poste, Luminaria, Lampara, Caja, ModeloLuminaria. Cardinalidad: 0..1."@es ;
    rdfs:comment "Manufacturer of the component. Applies to: Post, Luminaire, Lamp, JunctionBox, LuminaireModel. Cardinality: 0..1."@en .



# --- Localización ---

edintalu:direccion a owl:ObjectProperty ;
    rdfs:domain edintalu:Farola ;
    rdfs:range esdir:DireccionPostal ;
    rdfs:label "dirección"@es , "address"@en ;
    rdfs:comment "Dirección postal donde se ubica la farola. Se reutiliza esdir:DireccionPostal, que a su vez especializa schema:PostalAddress, vcard:Address y locn:Address."@es ;
    rdfs:comment "Postal address where the streetlight is located. Reuses esdir:DireccionPostal, which specialises schema:PostalAddress, vcard:Address and locn:Address."@en .

# --- Eficiencia y ahorro ---

edintalu:disponeReductorFlujo a owl:ObjectProperty ;
    rdfs:range edintalu:ReductorFlujo ;
    rdfs:label "dispone de reductor de flujo"@es , "has flow reducer"@en ;
    rdfs:comment "Reductor de flujo asociado. Aplica a: Farola. Cardinalidad: 0..n."@es ;
    rdfs:comment "Associated flow reducer. Applies to: Streetlight. Cardinality: 0..n."@en .

# --- Clasificaciones SKOS ---

edintalu:tipoSoporte a owl:ObjectProperty ;
    rdfs:domain edintalu:Poste ;
    rdfs:range skos:Concept ;
    rdfs:label "tipo de soporte"@es , "support type"@en ;
    rdfs:comment "Tipo de soporte físico del poste. SKOS con ~35 conceptos. ConceptScheme: tipo-soporte."@es ;
    rdfs:comment "Type of physical support of the post. SKOS with ~35 concepts. ConceptScheme: tipo-soporte."@en .

edintalu:tipoLuminaria a owl:ObjectProperty ;
    rdfs:domain edintalu:Luminaria ;
    rdfs:range skos:Concept ;
    rdfs:label "tipo de luminaria"@es , "luminaire type"@en ;
    rdfs:comment "Tipo de luminaria. SKOS con 8 conceptos (Proyector, Empotrado pared, Baliza, Viaria, Artística, etc.)."@es ;
    rdfs:comment "Type of luminaire. SKOS with 8 concepts (Projector, Recessed wall, Bollard, Road, Artistic, etc.)."@en .

edintalu:tipoLampara a owl:ObjectProperty ;
    rdfs:domain edintalu:Lampara ;
    rdfs:range skos:Concept ;
    rdfs:label "tipo de lámpara"@es , "lamp type"@en ;
    rdfs:comment "Tipo de lámpara. SKOS con 12 conceptos (LED, Vapor sodio, Vapor mercurio, Halogenuro metálico, etc.)."@es ;
    rdfs:comment "Type of lamp. SKOS with 12 concepts (LED, Sodium vapor, Mercury vapor, Metal halide, etc.)."@en .

edintalu:tipoAlumbrado a owl:ObjectProperty ;
    rdfs:domain edintalu:Farola ;
    rdfs:range skos:Concept ;
    rdfs:label "tipo de alumbrado"@es , "illumination class"@en ;
    rdfs:comment "Clase de alumbrado según EN 13201. SKOS: S1-S4, CE2-CE4, ME3C-ME5."@es ;
    rdfs:comment "Lighting class according to EN 13201. SKOS: S1-S4, CE2-CE4, ME3C-ME5."@en .

edintalu:tipoAlimentacion a owl:ObjectProperty ;
    rdfs:domain edintalu:Farola ;
    rdfs:range skos:Concept ;
    rdfs:label "tipo de alimentación"@es , "power supply type"@en ;
    rdfs:comment "Tipo de alimentación eléctrica. SKOS con 5 conceptos (Subterránea, Aérea, Fachada, Grapada, Batería)."@es ;
    rdfs:comment "Type of electrical supply. SKOS with 5 concepts (Underground, Aerial, Wall, Stapled, Battery)."@en .

edintalu:tipoIluminacion a owl:ObjectProperty ;
    rdfs:domain edintalu:Farola ;
    rdfs:range skos:Concept ;
    rdfs:label "tipo de iluminación"@es , "illumination type"@en ;
    rdfs:comment "Tipo de iluminación. SKOS: Nocturna, Permanente."@es ;
    rdfs:comment "Type of illumination. SKOS: Nighttime, Permanent."@en .

edintalu:tipoCable a owl:ObjectProperty ;
    rdfs:domain edintalu:Caja ;
    rdfs:range skos:Concept ;
    rdfs:label "tipo de cable"@es , "cable type"@en ;
    rdfs:comment "Tipo de cable en la caja de conexiones. SKOS: ET103, ET106, ET107, ET112, ET113."@es ;
    rdfs:comment "Cable type in the junction box. SKOS: ET103, ET106, ET107, ET112, ET113."@en .

edintalu:estadoConservacion a owl:ObjectProperty ;
    rdfs:domain edintalu:Farola ;
    rdfs:range skos:Concept ;
    rdfs:label "estado de conservación"@es , "conservation status"@en ;
    rdfs:comment "Estado de conservación de la farola. SKOS con 5 niveles: Excelente, Bueno, Regular, Malo, En ejecución."@es ;
    rdfs:comment "Conservation status of the streetlight. SKOS with 5 levels: Excellent, Good, Regular, Poor, Under construction."@en .

edintalu:zonaAlumbrado a owl:ObjectProperty ;
    rdfs:domain edintalu:Farola ;
    rdfs:range skos:Concept ;
    rdfs:label "zona de alumbrado"@es , "lighting zone"@en ;
    rdfs:comment "Clasificación de zona según REEAE (RD 1890/2008) para control de contaminación lumínica. SKOS: E1 (protección máxima), E2 (protección alta), E3 (protección media), E4 (protección baja)."@es ;
    rdfs:comment "Zone classification according to REEAE (RD 1890/2008) for light pollution control. SKOS: E1 (maximum protection), E2 (high protection), E3 (medium protection), E4 (low protection)."@en .

edintalu:claseLuminotecnica a owl:ObjectProperty ;
    rdfs:domain edintalu:Farola ;
    rdfs:range skos:Concept ;
    rdfs:label "clase luminotécnica"@es , "road lighting class"@en ;
    rdfs:comment "Clase luminotécnica según UNE-EN 13201 que determina los requisitos mínimos de alumbrado. SKOS: A (autopistas), B (arteriales), C (colectoras), D (residenciales), E (peatonales)."@es ;
    rdfs:comment "Lighting class according to UNE-EN 13201 determining minimum lighting requirements. SKOS: A (motorways), B (arterial), C (collector), D (residential), E (pedestrian)."@en .

# ============================================================
# DATA PROPERTIES
# ============================================================

# --- Poste ---

edintalu:altura a owl:DatatypeProperty ;
    rdfs:range xsd:decimal ;
    rdfs:label "altura"@es , "height"@en ;
    rdfs:comment "Altura en metros (m). Aplica a: Poste (altura total), Brazo (altura del brazo sobre el suelo)."@es ;
    rdfs:comment "Height in meters (m). Applies to: Post (total height), Arm (height of the arm above ground)."@en ;
    qudt:applicableUnit qudtu:M .

edintalu:tieneBrazo a owl:ObjectProperty ;
    rdfs:domain edintalu:Poste ;
    rdfs:range edintalu:Brazo ;
    rdfs:label "tiene brazo"@es , "has arm"@en ;
    rdfs:comment "Brazo del poste. Cardinalidad: 0..n."@es ;
    rdfs:comment "Arm of the post. Cardinality: 0..n."@en .

edintalu:numeroDeBrazos a owl:DatatypeProperty ;
    rdfs:domain edintalu:Poste ;
    rdfs:range xsd:integer ;
    rdfs:label "número de brazos"@es , "number of arms"@en ;
    rdfs:comment "Número total de brazos del poste."@es ;
    rdfs:comment "Total number of arms of the post."@en .

edintalu:ordenBrazo a owl:DatatypeProperty ;
    rdfs:domain edintalu:Brazo ;
    rdfs:range xsd:integer ;
    rdfs:label "orden del brazo"@es , "arm order"@en ;
    rdfs:comment "Posición ordinal del brazo en el poste (1, 2, 3...)."@es ;
    rdfs:comment "Ordinal position of the arm on the post (1, 2, 3...)."@en .

edintalu:accesorios a owl:DatatypeProperty ;
    rdfs:domain edintalu:Poste ;
    rdfs:range xsd:string ;
    rdfs:label "accesorios"@es , "accessories"@en ;
    rdfs:comment "Accesorios montados en el poste (medidores, cámaras, etc.)."@es ;
    rdfs:comment "Accessories mounted on the post (meters, cameras, etc.)."@en .

# --- Luminaria ---

edintalu:numeroDeLuminarias a owl:DatatypeProperty ;
    rdfs:domain edintalu:Luminaria ;
    rdfs:range xsd:integer ;
    rdfs:label "número de luminarias"@es , "number of luminaires"@en ;
    rdfs:comment "Número de luminarias en la farola."@es ;
    rdfs:comment "Number of luminaires in the streetlight."@en .

edintalu:flujoHemisfericoSuperior a owl:DatatypeProperty ;
    rdfs:domain edintalu:Luminaria ;
    rdfs:range xsd:decimal ;
    rdfs:label "flujo hemisférico superior"@es , "upper hemisphere flux"@en ;
    rdfs:comment "Flujo hemisférico superior (FHS/ULOR) de la luminaria como porcentaje. Clave para el cumplimiento del REEAE en zonas E1-E4."@es ;
    rdfs:comment "Upper hemisphere flux (FHS/ULOR) of the luminaire as a percentage. Key for REEAE compliance in zones E1-E4."@en ;
    qudt:applicableUnit qudtu:PERCENT .

# --- Lámpara ---

edintalu:potenciaNominal a owl:DatatypeProperty ;
    rdfs:domain edintalu:Lampara ;
    rdfs:range xsd:decimal ;
    rdfs:label "potencia nominal"@es , "nominal power"@en ;
    rdfs:comment "Potencia nominal de la lámpara. En vatios (W)."@es ;
    rdfs:comment "Nominal power of the lamp. In watts (W)."@en ;
    qudt:applicableUnit qudtu:W , qudtu:KiloW .

edintalu:flujoLuminoso a owl:DatatypeProperty ;
    rdfs:domain edintalu:Lampara ;
    rdfs:range xsd:decimal ;
    rdfs:label "flujo luminoso"@es , "luminous flux"@en ;
    rdfs:comment "Flujo luminoso de la lámpara en lúmenes (lm)."@es ;
    rdfs:comment "Luminous flux of the lamp in lumens (lm)."@en ;
    qudt:applicableUnit qudtu:LM .

edintalu:temperaturaColor a owl:DatatypeProperty ;
    rdfs:domain edintalu:Lampara ;
    rdfs:range xsd:decimal ;
    rdfs:label "temperatura de color"@es , "correlated color temperature"@en ;
    rdfs:comment "Temperatura de color correlacionada (CCT) de la lámpara en kelvin (K)."@es ;
    rdfs:comment "Correlated color temperature (CCT) of the lamp in kelvin (K)."@en ;
    qudt:applicableUnit qudtu:K .

edintalu:indiceReproduccionCromatica a owl:DatatypeProperty ;
    rdfs:domain edintalu:Lampara ;
    rdfs:range xsd:decimal ;
    rdfs:label "índice de reproducción cromática"@es , "color rendering index"@en ;
    rdfs:comment "Índice de reproducción cromática (CRI/IRC) de la lámpara (0-100)."@es ;
    rdfs:comment "Color rendering index (CRI) of the lamp (0-100)."@en .

edintalu:eficaciaLuminosa a owl:DatatypeProperty ;
    rdfs:domain edintalu:Lampara ;
    rdfs:range xsd:decimal ;
    rdfs:label "eficacia luminosa"@es , "luminous efficacy"@en ;
    rdfs:comment "Eficacia luminosa de la lámpara en lúmenes por vatio (lm/W)."@es ;
    rdfs:comment "Luminous efficacy of the lamp in lumens per watt (lm/W)."@en .

edintalu:intensidadLuminica a owl:DatatypeProperty ;
    rdfs:domain edintalu:Lampara ;
    rdfs:range xsd:decimal ;
    rdfs:label "intensidad lumínica"@es , "luminous intensity"@en ;
    rdfs:comment "Intensidad lumínica de la lámpara en candelas (cd)."@es ;
    rdfs:comment "Luminous intensity of the lamp in candelas (cd)."@en ;
    qudt:applicableUnit qudtu:CD .

edintalu:vidaUtilL70 a owl:DatatypeProperty ;
    rdfs:domain edintalu:Lampara ;
    rdfs:range xsd:decimal ;
    rdfs:label "vida útil L70"@es , "rated life L70"@en ;
    rdfs:comment "Vida útil nominal de la lámpara al 70% de flujo mantenido (L70) en horas."@es ;
    rdfs:comment "Rated life of the lamp at 70% maintained flux (L70) in hours."@en ;
    qudt:applicableUnit qudtu:HR .

edintalu:vidaUtilL80 a owl:DatatypeProperty ;
    rdfs:domain edintalu:Lampara ;
    rdfs:range xsd:decimal ;
    rdfs:label "vida útil L80"@es , "rated life L80"@en ;
    rdfs:comment "Vida útil nominal de la lámpara al 80% de flujo mantenido (L80) en horas."@es ;
    rdfs:comment "Rated life of the lamp at 80% maintained flux (L80) in hours."@en ;
    qudt:applicableUnit qudtu:HR .

edintalu:modeloBombilla a owl:DatatypeProperty ;
    rdfs:domain edintalu:Lampara ;
    rdfs:range xsd:string ;
    rdfs:label "modelo de bombilla"@es , "bulb model"@en ;
    rdfs:comment "Código o modelo de la bombilla."@es ;
    rdfs:comment "Code or model of the bulb."@en .

edintalu:fechaInstalacion a owl:DatatypeProperty ;
    rdfs:domain edintalu:Lampara ;
    rdfs:range xsd:dateTime ;
    rdfs:label "fecha de instalación"@es , "installation date"@en ;
    rdfs:comment "Fecha de instalación de la lámpara."@es ;
    rdfs:comment "Installation date of the lamp."@en .

# --- Farola ---

edintalu:horasDeFuncionamiento a owl:DatatypeProperty ;
    rdfs:domain edintalu:Farola ;
    rdfs:range xsd:string ;
    rdfs:label "horas de funcionamiento"@es , "operating hours"@en ;
    rdfs:comment "Horario en que el alumbrado está encendido (ej: '22:00-07:00')."@es ;
    rdfs:comment "Schedule when the lighting is on (e.g., '22:00-07:00')."@en .

edintalu:metodoDeControl a owl:DatatypeProperty ;
    rdfs:domain edintalu:Farola ;
    rdfs:range xsd:string ;
    rdfs:label "método de control"@es , "control method"@en ;
    rdfs:comment "Método de activación/desactivación del alumbrado (reloj astronómico, fotocélula, telegestión, etc.)."@es ;
    rdfs:comment "Method for switching the lighting on/off (astronomical clock, photocell, remote management, etc.)."@en .

edintalu:calidadDato a owl:DatatypeProperty ;
    rdfs:domain edintalu:Farola ;
    rdfs:range xsd:string ;
    rdfs:label "calidad del dato"@es , "data quality"@en ;
    rdfs:comment "Calidad del dato: B (buena), R (regular), M (mala), E (en ejecución)."@es ;
    rdfs:comment "Data quality: B (good), R (regular), M (poor), E (under construction)."@en .

edintalu:observaciones a owl:DatatypeProperty ;
    rdfs:range xsd:string ;
    rdfs:label "observaciones"@es , "notes"@en ;
    rdfs:comment "Observaciones sobre la farola o componente. Aplica a: Farola, Poste, Luminaria, Lampara, Caja."@es ;
    rdfs:comment "Notes about the streetlight or component. Applies to: Streetlight, Post, Luminaire, Lamp, JunctionBox."@en .

# --- ConsumoEnergetico (valores vía sosa:hasResult → qudt:QuantityValue) ---

edintalu:periodoTarifario a owl:ObjectProperty ;
    rdfs:domain edintalu:ConsumoEnergetico ;
    rdfs:range skos:Concept ;
    rdfs:label "período tarifario"@es , "tariff period"@en ;
    rdfs:comment "Período tarifario al que corresponde el consumo. SKOS: activo, llano, valle, punta. Cada instancia de ConsumoEnergetico representa UN período tarifario; el total se obtiene sumando las instancias del mismo ejercicio."@es ;
    rdfs:comment "Tariff period to which the consumption corresponds. SKOS: active, standard, off-peak, peak. Each ConsumoEnergetico instance represents ONE tariff period; the total is obtained by summing instances of the same fiscal year."@en .

edintalu:ejercicio a owl:DatatypeProperty ;
    rdfs:range xsd:gYear ;
    rdfs:label "ejercicio"@es , "fiscal year"@en ;
    rdfs:comment "Año de referencia de los datos. Aplica a: ConsumoEnergetico, SuministroElectrico."@es ;
    rdfs:comment "Reference year of the data. Applies to: ConsumoEnergetico, SuministroElectrico."@en .

# --- SuministroElectrico ---

edintalu:tarifa a owl:DatatypeProperty ;
    rdfs:domain edintalu:SuministroElectrico ;
    rdfs:range xsd:string ;
    rdfs:label "tarifa"@es , "tariff"@en ;
    rdfs:comment "Tipo de tarifa eléctrica aplicada (ej: 6.1, 6.2, 6.3, 6.4)."@es ;
    rdfs:comment "Type of electricity tariff applied (e.g., 6.1, 6.2, 6.3, 6.4)."@en .

edintalu:tension a owl:DatatypeProperty ;
    rdfs:domain edintalu:SuministroElectrico ;
    rdfs:range xsd:decimal ;
    rdfs:label "tensión"@es , "voltage"@en ;
    rdfs:comment "Tensión de alimentación del suministro en voltios (V)."@es ;
    rdfs:comment "Supply voltage in volts (V)."@en ;
    qudt:applicableUnit qudtu:V .

edintalu:kwhRenovables a owl:DatatypeProperty ;
    rdfs:domain edintalu:SuministroElectrico ;
    rdfs:range xsd:decimal ;
    rdfs:label "kWh renovables"@es , "renewable kWh"@en ;
    rdfs:comment "Consumo en kWh de fuentes de energía renovable con sistemas de autoconsumo."@es ;
    rdfs:comment "Consumption in kWh from renewable energy sources with self-consumption systems."@en ;
    qudt:applicableUnit qudtu:KiloW-HR .



# --- ReductorFlujo ---

edintalu:esReductorFlujoLuminaria a owl:DatatypeProperty ;
    rdfs:domain edintalu:ReductorFlujo ;
    rdfs:range xsd:boolean ;
    rdfs:label "es reductor de flujo en luminaria"@es , "is luminaire flow reducer"@en ;
    rdfs:comment "Indica si dispone de sistema de reducción de flujo en la luminaria."@es ;
    rdfs:comment "Indicates whether a flow reduction system is available in the luminaire."@en .

edintalu:esReductorFlujoInicio a owl:DatatypeProperty ;
    rdfs:domain edintalu:ReductorFlujo ;
    rdfs:range xsd:boolean ;
    rdfs:label "es reductor de flujo al inicio"@es , "is head-end flow reducer"@en ;
    rdfs:comment "Indica si dispone de sistema de reducción de flujo al inicio de la instalación (regulador de cabecera)."@es ;
    rdfs:comment "Indicates whether a flow reduction system is available at the start of the installation (head-end regulator)."@en .

# --- Catálogo y titularidad (nombres) ---

edintalu:nombre a owl:DatatypeProperty ;
    rdfs:range xsd:string ;
    rdfs:label "nombre"@es , "name"@en ;
    rdfs:comment "Nombre de la entidad. Aplica a: CentroDeMando, Fabricante, ModeloLuminaria."@es ;
    rdfs:comment "Name of the entity. Applies to: ControlCenter, Manufacturer, Owner, LuminaireModel."@en .

# --- Compartidos: material, identifier ---

edintalu:material a owl:DatatypeProperty ;
    rdfs:range xsd:string ;
    rdfs:label "material"@es , "material"@en ;
    rdfs:comment "Material del componente. Aplica a: Poste, Luminaria, Lampara, Caja."@es ;
    rdfs:comment "Material of the component. Applies to: Post, Luminaire, Lamp, JunctionBox."@en .

