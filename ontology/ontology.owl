        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#boolean"/>
        <rdfs:comment xml:lang="es">Indica si dispone de sistema de reducción de flujo en la luminaria.</rdfs:comment>
        <rdfs:comment xml:lang="en">Indicates whether a flow reduction system is available in the luminaire.</rdfs:comment>
        <rdfs:label xml:lang="es">es reductor de flujo en luminaria</rdfs:label>
        <rdfs:label xml:lang="en">is luminaire flow reducer</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- http://vocab.linkeddata.es/datosabiertos/def/urbanismo-infraestructuras/alumbrado-publico#fechaInstalacion -->

    <owl:DatatypeProperty rdf:about="http://vocab.linkeddata.es/datosabiertos/def/urbanismo-infraestructuras/alumbrado-publico#fechaInstalacion">
        <rdfs:domain rdf:resource="http://vocab.linkeddata.es/datosabiertos/def/urbanismo-infraestructuras/alumbrado-publico#Lampara"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#dateTime"/>
        <rdfs:comment xml:lang="es">Fecha de instalación de la lámpara.</rdfs:comment>
        <rdfs:comment xml:lang="en">Installation date of the lamp.</rdfs:comment>
        <rdfs:label xml:lang="es">fecha de instalación</rdfs:label>
        <rdfs:label xml:lang="en">installation date</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- http://vocab.linkeddata.es/datosabiertos/def/urbanismo-infraestructuras/alumbrado-publico#horasDeFuncionamiento -->

    <owl:DatatypeProperty rdf:about="http://vocab.linkeddata.es/datosabiertos/def/urbanismo-infraestructuras/alumbrado-publico#horasDeFuncionamiento">
        <rdfs:domain rdf:resource="http://vocab.linkeddata.es/datosabiertos/def/urbanismo-infraestructuras/alumbrado-publico#Farola"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:comment xml:lang="es">Horario en que el alumbrado está encendido (ej: &apos;22:00-07:00&apos;).</rdfs:comment>
        <rdfs:comment xml:lang="en">Schedule when the lighting is on (e.g., &apos;22:00-07:00&apos;).</rdfs:comment>
        <rdfs:label xml:lang="es">horas de funcionamiento</rdfs:label>
        <rdfs:label xml:lang="en">operating hours</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- http://vocab.linkeddata.es/datosabiertos/def/urbanismo-infraestructuras/alumbrado-publico#indiceReproduccionCromatica -->

    <owl:DatatypeProperty rdf:about="http://vocab.linkeddata.es/datosabiertos/def/urbanismo-infraestructuras/alumbrado-publico#indiceReproduccionCromatica">
        <rdfs:domain rdf:resource="http://vocab.linkeddata.es/datosabiertos/def/urbanismo-infraestructuras/alumbrado-publico#Lampara"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#decimal"/>
        <rdfs:comment xml:lang="en">Color rendering index (CRI) of the lamp (0-100).</rdfs:comment>
        <rdfs:comment xml:lang="es">Índice de reproducción cromática (CRI/IRC) de la lámpara (0-100).</rdfs:comment>
        <rdfs:label xml:lang="en">color rendering index</rdfs:label>
        <rdfs:label xml:lang="es">índice de reproducción cromática</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- http://vocab.linkeddata.es/datosabiertos/def/urbanismo-infraestructuras/alumbrado-publico#material -->

    <owl:DatatypeProperty rdf:about="http://vocab.linkeddata.es/datosabiertos/def/urbanismo-infraestructuras/alumbrado-publico#material">
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:comment xml:lang="es">Material del componente. Aplica a: Poste, Luminaria, Lampara, Caja.</rdfs:comment>
        <rdfs:comment xml:lang="en">Material of the component. Applies to: Post, Luminaire, Lamp, JunctionBox.</rdfs:comment>
        <rdfs:label xml:lang="en">material</rdfs:label>
        <rdfs:label xml:lang="es">material</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- http://vocab.linkeddata.es/datosabiertos/def/urbanismo-infraestructuras/alumbrado-publico#metodoDeControl -->

    <owl:DatatypeProperty rdf:about="http://vocab.linkeddata.es/datosabiertos/def/urbanismo-infraestructuras/alumbrado-publico#metodoDeControl">
        <rdfs:domain rdf:resource="http://vocab.linkeddata.es/datosabiertos/def/urbanismo-infraestructuras/alumbrado-publico#Farola"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:comment xml:lang="en">Method for switching the lighting on/off (astronomical clock, photocell, remote management, etc.).</rdfs:comment>
        <rdfs:comment xml:lang="es">Método de activación/desactivación del alumbrado (reloj astronómico, fotocélula, telegestión, etc.).</rdfs:comment>
        <rdfs:label xml:lang="en">control method</rdfs:label>
        <rdfs:label xml:lang="es">método de control</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- http://vocab.linkeddata.es/datosabiertos/def/urbanismo-infraestructuras/alumbrado-publico#modeloBombilla -->

    <owl:DatatypeProperty rdf:about="http://vocab.linkeddata.es/datosabiertos/def/urbanismo-infraestructuras/alumbrado-publico#modeloBombilla">
        <rdfs:domain rdf:resource="http://vocab.linkeddata.es/datosabiertos/def/urbanismo-infraestructuras/alumbrado-publico#Lampara"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:comment xml:lang="en">Code or model of the bulb.</rdfs:comment>
        <rdfs:comment xml:lang="es">Código o modelo de la bombilla.</rdfs:comment>
        <rdfs:label xml:lang="en">bulb model</rdfs:label>
        <rdfs:label xml:lang="es">modelo de bombilla</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- http://vocab.linkeddata.es/datosabiertos/def/urbanismo-infraestructuras/alumbrado-publico#nombre -->

    <owl:DatatypeProperty rdf:about="http://vocab.linkeddata.es/datosabiertos/def/urbanismo-infraestructuras/alumbrado-publico#nombre">
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:comment xml:lang="en">Name of the entity. Applies to: ControlCenter, Manufacturer, Owner, LuminaireModel.</rdfs:comment>
        <rdfs:comment xml:lang="es">Nombre de la entidad. Aplica a: CentroDeMando, Fabricante, ModeloLuminaria.</rdfs:comment>
        <rdfs:label xml:lang="en">name</rdfs:label>
        <rdfs:label xml:lang="es">nombre</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- http://vocab.linkeddata.es/datosabiertos/def/urbanismo-infraestructuras/alumbrado-publico#numeroDeBrazos -->

    <owl:DatatypeProperty rdf:about="http://vocab.linkeddata.es/datosabiertos/def/urbanismo-infraestructuras/alumbrado-publico#numeroDeBrazos">
        <rdfs:domain rdf:resource="http://vocab.linkeddata.es/datosabiertos/def/urbanismo-infraestructuras/alumbrado-publico#Poste"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#integer"/>
        <rdfs:comment xml:lang="es">Número total de brazos del poste.</rdfs:comment>
        <rdfs:comment xml:lang="en">Total number of arms of the post.</rdfs:comment>
        <rdfs:label xml:lang="en">number of arms</rdfs:label>
        <rdfs:label xml:lang="es">número de brazos</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- http://vocab.linkeddata.es/datosabiertos/def/urbanismo-infraestructuras/alumbrado-publico#numeroDeLuminarias -->

    <owl:DatatypeProperty rdf:about="http://vocab.linkeddata.es/datosabiertos/def/urbanismo-infraestructuras/alumbrado-publico#numeroDeLuminarias">
        <rdfs:domain rdf:resource="http://vocab.linkeddata.es/datosabiertos/def/urbanismo-infraestructuras/alumbrado-publico#Farola"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#integer"/>
        <rdfs:comment xml:lang="en">Number of luminaires in the streetlight.</rdfs:comment>
        <rdfs:comment xml:lang="es">Número de luminarias en la farola.</rdfs:comment>
        <rdfs:label xml:lang="en">number of luminaires</rdfs:label>
        <rdfs:label xml:lang="es">número de luminarias</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- http://vocab.linkeddata.es/datosabiertos/def/urbanismo-infraestructuras/alumbrado-publico#observaciones -->

    <owl:DatatypeProperty rdf:about="http://vocab.linkeddata.es/datosabiertos/def/urbanismo-infraestructuras/alumbrado-publico#observaciones">
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:comment xml:lang="en">Notes about the streetlight or component. Applies to: Streetlight, Post, Luminaire, Lamp, JunctionBox.</rdfs:comment>
        <rdfs:comment xml:lang="es">Observaciones sobre la farola o componente. Aplica a: Farola, Poste, Luminaria, Lampara, Caja.</rdfs:comment>
        <rdfs:label xml:lang="en">notes</rdfs:label>
        <rdfs:label xml:lang="es">observaciones</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- http://vocab.linkeddata.es/datosabiertos/def/urbanismo-infraestructuras/alumbrado-publico#ordenBrazo -->

    <owl:DatatypeProperty rdf:about="http://vocab.linkeddata.es/datosabiertos/def/urbanismo-infraestructuras/alumbrado-publico#ordenBrazo">
        <rdfs:domain rdf:resource="http://vocab.linkeddata.es/datosabiertos/def/urbanismo-infraestructuras/alumbrado-publico#Brazo"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#integer"/>
        <rdfs:comment xml:lang="en">Ordinal position of the arm on the post (1, 2, 3...).</rdfs:comment>
        <rdfs:comment xml:lang="es">Posición ordinal del brazo en el poste (1, 2, 3...).</rdfs:comment>
        <rdfs:label xml:lang="en">arm order</rdfs:label>
        <rdfs:label xml:lang="es">orden del brazo</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- http://vocab.linkeddata.es/datosabiertos/def/urbanismo-infraestructuras/alumbrado-publico#tarifa -->

    <owl:DatatypeProperty rdf:about="http://vocab.linkeddata.es/datosabiertos/def/urbanismo-infraestructuras/alumbrado-publico#tarifa">
        <rdfs:domain rdf:resource="http://vocab.linkeddata.es/datosabiertos/def/urbanismo-infraestructuras/alumbrado-publico#SuministroElectrico"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:comment xml:lang="es">Tipo de tarifa eléctrica aplicada (ej: 6.1, 6.2, 6.3, 6.4).</rdfs:comment>
        <rdfs:comment xml:lang="en">Type of electricity tariff applied (e.g., 6.1, 6.2, 6.3, 6.4).</rdfs:comment>
        <rdfs:label xml:lang="es">tarifa</rdfs:label>
        <rdfs:label xml:lang="en">tariff</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- 
    ///////////////////////////////////////////////////////////////////////////////////////
    //
    // Classes
    //
    ///////////////////////////////////////////////////////////////////////////////////////
     -->

    


    <!-- http://qudt.org/schema/qudt/QuantityValue -->

    <owl:Class rdf:about="http://qudt.org/schema/qudt/QuantityValue"/>
    


    <!-- http://vocab.linkeddata.es/datosabiertos/def/urbanismo-infraestructuras/alumbrado-publico#Brazo -->

    <owl:Class rdf:about="http://vocab.linkeddata.es/datosabiertos/def/urbanismo-infraestructuras/alumbrado-publico#Brazo">
        <rdfs:comment xml:lang="en">Arm of the post that supports a luminaire. A post can have multiple arms, each with its own height.</rdfs:comment>
        <rdfs:comment xml:lang="es">Brazo del poste que soporta una luminaria. Un poste puede tener múltiples brazos, cada uno con su propia altura.</rdfs:comment>
        <rdfs:label xml:lang="en">Arm</rdfs:label>
        <rdfs:label xml:lang="es">Brazo</rdfs:label>
    </owl:Class>
    


    <!-- http://vocab.linkeddata.es/datosabiertos/def/urbanismo-infraestructuras/alumbrado-publico#Caja -->

    <owl:Class rdf:about="http://vocab.linkeddata.es/datosabiertos/def/urbanismo-infraestructuras/alumbrado-publico#Caja">
        <rdfs:comment xml:lang="es">Caja de conexiones o registro de acceso a los cables eléctricos de la farola. Opcional: no todas las farolas tienen una caja accesible.</rdfs:comment>
        <rdfs:comment xml:lang="en">Junction box or access point for the streetlight&apos;s electrical cables. Optional: not all streetlights have an accessible box.</rdfs:comment>
        <rdfs:label xml:lang="es">Caja</rdfs:label>
        <rdfs:label xml:lang="en">Junction Box</rdfs:label>
    </owl:Class>
    


    <!-- http://vocab.linkeddata.es/datosabiertos/def/urbanismo-infraestructuras/alumbrado-publico#CentroDeMando -->

    <owl:Class rdf:about="http://vocab.linkeddata.es/datosabiertos/def/urbanismo-infraestructuras/alumbrado-publico#CentroDeMando">
        <rdfs:subClassOf rdf:resource="http://vocab.linkeddata.es/datosabiertos/def/urbanismo-infraestructuras/suministro#UtilitySupplyPoint"/>
        <rdfs:comment xml:lang="es">Cuadro eléctrico o centro de control del que dependen una o más farolas. Es un punto de suministro (edintsum:UtilitySupplyPoint), punto donde llega la electricidad a la instalación de alumbrado.</rdfs:comment>
        <rdfs:comment xml:lang="en">Electrical panel or control center on which one or more streetlights depend. It is a utility supply point (edintsum:UtilitySupplyPoint), the point where electricity reaches the lighting installation.</rdfs:comment>
        <rdfs:label xml:lang="es">Centro de mando</rdfs:label>
        <rdfs:label xml:lang="en">Control Center</rdfs:label>
    </owl:Class>
    


    <!-- http://vocab.linkeddata.es/datosabiertos/def/urbanismo-infraestructuras/alumbrado-publico#ConsumoEnergetico -->

    <owl:Class rdf:about="http://vocab.linkeddata.es/datosabiertos/def/urbanismo-infraestructuras/alumbrado-publico#ConsumoEnergetico">
        <rdfs:subClassOf rdf:resource="http://vocab.linkeddata.es/datosabiertos/def/urbanismo-infraestructuras/suministro#UtilityConsumption"/>
        <rdfs:comment xml:lang="es">Observación de consumo eléctrico en un período tarifario determinado. Al heredar de edintsum:UtilityConsumption ⊂ sosa:Observation, usa el patrón SOSA: – sosa:hasFeatureOfInterest → el CentroDeMando (punto de suministro) – sosa:observedProperty → edintsum:electricityConsumption – sosa:hasResult → qudt:QuantityValue (qudt:numericValue + qudt:hasUnit) – edintalu:periodoTarifario → concepto SKOS (activo, llano, valle, punta) Cada instancia representa el consumo en UN período tarifario. El total se obtiene sumando las instancias del mismo ejercicio.</rdfs:comment>
        <rdfs:comment xml:lang="en">Observation of electricity consumption in a specific tariff period. By inheriting from edintsum:UtilityConsumption ⊂ sosa:Observation, uses the SOSA pattern: – sosa:hasFeatureOfInterest → the CentroDeMando (supply point) – sosa:observedProperty → edintsum:electricityConsumption – sosa:hasResult → qudt:QuantityValue (qudt:numericValue + qudt:hasUnit) – edintalu:periodoTarifario → SKOS concept (active, standard, off-peak, peak) Each instance represents consumption in ONE tariff period. The total is obtained by summing instances of the same fiscal year.</rdfs:comment>
        <rdfs:label xml:lang="es">Consumo energético</rdfs:label>
        <rdfs:label xml:lang="en">Energy Consumption</rdfs:label>
    </owl:Class>
    


    <!-- http://vocab.linkeddata.es/datosabiertos/def/urbanismo-infraestructuras/alumbrado-publico#Fabricante -->

    <owl:Class rdf:about="http://vocab.linkeddata.es/datosabiertos/def/urbanismo-infraestructuras/alumbrado-publico#Fabricante">
        <rdfs:comment xml:lang="es">Entidad que fabrica componentes del alumbrado (postes, luminarias, lámparas, cajas o modelos).</rdfs:comment>
        <rdfs:comment xml:lang="en">Entity that manufactures street lighting components (posts, luminaires, lamps, boxes or models).</rdfs:comment>
        <rdfs:label xml:lang="es">Fabricante</rdfs:label>
        <rdfs:label xml:lang="en">Manufacturer</rdfs:label>
    </owl:Class>
    


    <!-- http://vocab.linkeddata.es/datosabiertos/def/urbanismo-infraestructuras/alumbrado-publico#Farola -->

    <owl:Class rdf:about="http://vocab.linkeddata.es/datosabiertos/def/urbanismo-infraestructuras/alumbrado-publico#Farola">
        <rdfs:subClassOf rdf:resource="http://vocab.linkeddata.es/datosabiertos/def/urbanismo-infraestructuras/infraestructura#UrbanElement"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://vocab.linkeddata.es/datosabiertos/def/urbanismo-infraestructuras/infraestructura#hasInfrastructureType"/>
                <owl:hasValue rdf:resource="http://vocab.linkeddata.es/datosabiertos/kos/edint/InfrastructureType/StreeLamp"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:comment xml:lang="en">A complete point of light, composed of a post, one or more luminaires (which in turn contain lamps) and optionally a junction box. It is an urban element (edintinf:UrbanElement) and, by inheritance, an InfrastructureElement that can have a utility supply point (edintsum:hasUtilitySupplyPoint). Every instance of Farola has infrastructure type &apos;Street lamp&apos; (edintkosinftype:StreeLamp) from the EDINT SKOS.</rdfs:comment>
        <rdfs:comment xml:lang="es">Punto de luz completo, compuesto por un poste, una o más luminarias (que a su vez contienen lámparas) y opcionalmente una caja de conexiones. Es un elemento urbano (edintinf:UrbanElement) y, por herencia, un InfrastructureElement que puede tener punto de suministro (edintsum:hasUtilitySupplyPoint). Toda instancia de Farola tiene como tipo de infraestructura &apos;Street lamp&apos; (edintkosinftype:StreeLamp) del SKOS de EDINT.</rdfs:comment>
        <rdfs:label xml:lang="es">Farola</rdfs:label>
        <rdfs:label xml:lang="en">Streetlight</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://vocab.linkeddata.es/datosabiertos/def/urbanismo-infraestructuras/alumbrado-publico/v1.0-rc/Farola"/>
    </owl:Class>
    


    <!-- http://vocab.linkeddata.es/datosabiertos/def/urbanismo-infraestructuras/alumbrado-publico#Lampara -->

    <owl:Class rdf:about="http://vocab.linkeddata.es/datosabiertos/def/urbanismo-infraestructuras/alumbrado-publico#Lampara">
        <rdfs:comment xml:lang="es">Fuente de luz: bombilla, módulo LED o convertidor de energía eléctrica en luz. Cada luminaria aloja exactamente una lámpara. Incluye propiedades fotométricas (potencia, flujo, CCT, CRI) y de vida útil (L70, L80).</rdfs:comment>
        <rdfs:comment xml:lang="en">Light source: bulb, LED module or converter of electrical energy into light. Each luminaire houses exactly one lamp. Includes photometric properties (power, luminous flux, CCT, CRI) and rated life (L70, L80).</rdfs:comment>
        <rdfs:label xml:lang="en">Lamp</rdfs:label>
        <rdfs:label xml:lang="es">Lámpara</rdfs:label>
    </owl:Class>
    


    <!-- http://vocab.linkeddata.es/datosabiertos/def/urbanismo-infraestructuras/alumbrado-publico#Luminaria -->

    <owl:Class rdf:about="http://vocab.linkeddata.es/datosabiertos/def/urbanismo-infraestructuras/alumbrado-publico#Luminaria">
        <rdfs:comment xml:lang="es">Aparato de iluminación que aloja, dirige y filtra la luz de la lámpara. Una farola puede tener múltiples luminarias (caso LED+DESCARGA). Puede referenciar un modelo del catálogo (ModeloLuminaria).</rdfs:comment>
        <rdfs:comment xml:lang="en">Lighting apparatus that houses, directs and filters the light from the lamp. A streetlight can have multiple luminaires (e.g., LED+DISCHARGE). Can reference a catalog model (ModeloLuminaria).</rdfs:comment>
        <rdfs:label xml:lang="en">Luminaire</rdfs:label>
        <rdfs:label xml:lang="es">Luminaria</rdfs:label>
    </owl:Class>
    


    <!-- http://vocab.linkeddata.es/datosabiertos/def/urbanismo-infraestructuras/alumbrado-publico#ModeloLuminaria -->

    <owl:Class rdf:about="http://vocab.linkeddata.es/datosabiertos/def/urbanismo-infraestructuras/alumbrado-publico#ModeloLuminaria">
        <rdfs:comment xml:lang="es">Entrada del catálogo de modelos de luminaria. Permite vincular fabricante, potencia nominal, tecnología y especificaciones fotométricas.</rdfs:comment>
        <rdfs:comment xml:lang="en">Entry in the luminaire model catalog. Allows linking manufacturer, nominal power, technology and photometric specifications.</rdfs:comment>
        <rdfs:label xml:lang="en">Luminaire Model</rdfs:label>
        <rdfs:label xml:lang="es">Modelo de luminaria</rdfs:label>
    </owl:Class>
    


    <!-- http://vocab.linkeddata.es/datosabiertos/def/urbanismo-infraestructuras/alumbrado-publico#Poste -->

    <owl:Class rdf:about="http://vocab.linkeddata.es/datosabiertos/def/urbanismo-infraestructuras/alumbrado-publico#Poste">
        <rdfs:comment xml:lang="en">Physical support of the streetlight: column, bracket, wall, short post, etc. The specific type is indicated via tipoSoporte (SKOS). A post can have one or more arms.</rdfs:comment>
        <rdfs:comment xml:lang="es">Soporte físico de la farola: columna, báculo, fachada, postelete, etc. El tipo concreto se indica mediante tipoSoporte (SKOS). Un poste puede tener uno o más brazos.</rdfs:comment>
        <rdfs:label xml:lang="en">Post</rdfs:label>
        <rdfs:label xml:lang="es">Poste</rdfs:label>
    </owl:Class>
    


    <!-- http://vocab.linkeddata.es/datosabiertos/def/urbanismo-infraestructuras/alumbrado-publico#ReductorFlujo -->

    <owl:Class rdf:about="http://vocab.linkeddata.es/datosabiertos/def/urbanismo-infraestructuras/alumbrado-publico#ReductorFlujo">
        <rdfs:comment xml:lang="en">Energy saving system that reduces luminous flux. Can be located in the luminaire (lamp regulator) or at the start of the installation (head-end regulator).</rdfs:comment>
        <rdfs:comment xml:lang="es">Sistema de ahorro energético que reduce el flujo luminoso. Puede estar ubicado en la luminaria (regulador de lámpara) o al inicio de la instalación (regulador de cabecera).</rdfs:comment>
        <rdfs:label xml:lang="en">Flow Reducer</rdfs:label>
        <rdfs:label xml:lang="es">Reductor de flujo</rdfs:label>
    </owl:Class>
    


    <!-- http://vocab.linkeddata.es/datosabiertos/def/urbanismo-infraestructuras/alumbrado-publico#SuministroElectrico -->

    <owl:Class rdf:about="http://vocab.linkeddata.es/datosabiertos/def/urbanismo-infraestructuras/alumbrado-publico#SuministroElectrico">
        <rdfs:subClassOf rdf:resource="http://vocab.linkeddata.es/datosabiertos/def/urbanismo-infraestructuras/suministro#UtilityContract"/>
        <rdfs:comment xml:lang="es">Contrato de suministro eléctrico asociado a un centro de mando. Incluye tarifa, tensión y consumo por períodos tarifarios. Es un contrato de suministro (edintsum:UtilityContract), con tarifa y punto de suministro asociado.</rdfs:comment>
        <rdfs:comment xml:lang="en">Electricity supply contract associated with a control center. Includes tariff, voltage, and consumption by tariff periods. It is a utility contract (edintsum:UtilityContract), with rate and associated supply point.</rdfs:comment>
        <rdfs:label xml:lang="en">Electricity Supply</rdfs:label>
        <rdfs:label xml:lang="es">Suministro eléctrico</rdfs:label>
    </owl:Class>
    


    <!-- http://vocab.linkeddata.es/datosabiertos/def/urbanismo-infraestructuras/direccion-postal#DireccionPostal -->

    <owl:Class rdf:about="http://vocab.linkeddata.es/datosabiertos/def/urbanismo-infraestructuras/direccion-postal#DireccionPostal">
