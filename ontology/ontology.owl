<?xml version="1.0"?>
<rdf:RDF xmlns="http://vocab.linkeddata.es/datosabiertos/def/urbanismo-infraestructuras/alumbrado-publico#"
     xml:base="http://vocab.linkeddata.es/datosabiertos/def/urbanismo-infraestructuras/alumbrado-publico"
     xmlns:gsp="http://www.opengis.net/ont/geosparql#"
     xmlns:owl="http://www.w3.org/2002/07/owl#"
     xmlns:rdf="http://www.w3.org/1999/02/22-rdf-syntax-ns#"
     xmlns:xml="http://www.w3.org/XML/1998/namespace"
     xmlns:xsd="http://www.w3.org/2001/XMLSchema#"
     xmlns:qudt="http://qudt.org/schema/qudt/"
     xmlns:rdfs="http://www.w3.org/2000/01/rdf-schema#"
     xmlns:skos="http://www.w3.org/2004/02/skos/core#"
     xmlns:sosa="http://www.w3.org/ns/sosa/"
     xmlns:vann="http://purl.org/vocab/vann/"
     xmlns:esadm="http://vocab.linkeddata.es/datosabiertos/def/sector-publico/territorio#"
     xmlns:esdir="http://vocab.linkeddata.es/datosabiertos/def/urbanismo-infraestructuras/direccion-postal#"
     xmlns:qudtu="http://qudt.org/vocab/unit/"
     xmlns:schema="http://schema.org/"
     xmlns:dcterms="http://purl.org/dc/terms/"
     xmlns:edintalu="http://vocab.linkeddata.es/datosabiertos/def/urbanismo-infraestructuras/alumbrado-publico#"
     xmlns:edintinf="http://vocab.linkeddata.es/datosabiertos/def/urbanismo-infraestructuras/infraestructura#"
     xmlns:edintsum="http://vocab.linkeddata.es/datosabiertos/def/urbanismo-infraestructuras/suministro#"
     xmlns:edintkosinftype="http://vocab.linkeddata.es/datosabiertos/kos/edint/InfrastructureType/">
    <owl:Ontology rdf:about="http://vocab.linkeddata.es/datosabiertos/def/urbanismo-infraestructuras/alumbrado-publico">
        <owl:versionIRI rdf:resource="http://vocab.linkeddata.es/datosabiertos/def/urbanismo-infraestructuras/alumbrado-publico/0.1.0"/>
        <owl:imports rdf:resource="http://www.w3.org/2004/02/skos/core"/>
        <dcterms:abstract xml:lang="en">Ontology for representing public street lighting data. Models the modular composition of streetlights, electrical infrastructure, energy consumption, and photometric and light pollution parameters.</dcterms:abstract>
        <dcterms:abstract xml:lang="es">Ontología para la representación de datos de alumbrado público. Modela la composición modular de farolas, la infraestructura eléctrica, el consumo energético y los parámetros fotométricos y de contaminación lumínica.</dcterms:abstract>
        <dcterms:contributor>Ontology Engineering Group, Universidad Politécnica de Madrid</dcterms:contributor>
        <dcterms:creator>Daniel Doña</dcterms:creator>
        <dcterms:creator>Edna Ruckhaus</dcterms:creator>
        <dcterms:creator>Lucía Sánchez</dcterms:creator>
        <dcterms:creator>M. Martín Blázquez</dcterms:creator>
        <dcterms:creator>María Poveda</dcterms:creator>
        <dcterms:creator>Oscar Corcho</dcterms:creator>
        <dcterms:description xml:lang="en">Ontology for representing public street lighting data in the context of FEMP (Spanish Federation of Municipalities and Provinces). Models: modular composition of streetlights (post, luminaire, lamp, box), electrical infrastructure (control center), energy consumption as SOSA observation with QUDT result, luminaire model catalog, manufacturer, photometric parameters and light pollution (FHS, zones E1-E4), and conservation status. Measurement units with QUDT.</dcterms:description>
        <dcterms:description xml:lang="es">Ontología para la representación de datos de alumbrado público en el contexto de la FEMP. Modela: composición modular de farolas (poste, luminaria, lámpara, caja), infraestructura eléctrica (centro de mando), consumo energético como observación SOSA con resultado QUDT, catálogo de modelos de luminaria, fabricante, parámetros fotométricos y de contaminación lumínica (FHS, zonas E1-E4), y estado de conservación. Unidades de medida con QUDT.</dcterms:description>
        <dcterms:publisher>FEMP — Federación Española de Municipios y Provincias</dcterms:publisher>
        <dcterms:title xml:lang="es">Ontología de Alumbrado Público</dcterms:title>
        <dcterms:title xml:lang="en">Public Street Lighting Ontology</dcterms:title>
        <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-05-07</dcterms:created>
        <dcterms:license rdf:resource="https://creativecommons.org/licenses/by/4.0/"/>
        <vann:preferredNamespacePrefix>edintalu</vann:preferredNamespacePrefix>
        <vann:preferredNamespaceUri>http://vocab.linkeddata.es/datosabiertos/def/urbanismo-infraestructuras/alumbrado-publico#</vann:preferredNamespaceUri>
        <rdfs:comment xml:lang="en">Ontology for representing public street lighting data.</rdfs:comment>
        <rdfs:comment xml:lang="es">Ontología para la representación de datos de alumbrado público.</rdfs:comment>
        <rdfs:label xml:lang="es">Ontología de Alumbrado Público</rdfs:label>
        <rdfs:label xml:lang="en">Public Street Lighting Ontology</rdfs:label>
        <rdfs:seeAlso rdf:resource="https://github.com/opencitydata/urbanismo-infraestructuras-alumbrado-publico"/>
        <owl:priorVersion rdf:resource="https://raw.githubusercontent.com/opencitydata/urbanismo-infraestructuras-alumbrado-publico/main/v1.0-rc/ontology/ontology.owl"/>
        <owl:versionInfo>0.1.0</owl:versionInfo>
    </owl:Ontology>
    


