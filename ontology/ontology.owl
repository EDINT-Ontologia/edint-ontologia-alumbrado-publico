        <rdfs:range rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <rdfs:comment xml:lang="es">Clasificación de zona según REEAE (RD 1890/2008) para control de contaminación lumínica. SKOS: E1 (protección máxima), E2 (protección alta), E3 (protección media), E4 (protección baja).</rdfs:comment>
        <rdfs:comment xml:lang="en">Zone classification according to REEAE (RD 1890/2008) for light pollution control. SKOS: E1 (maximum protection), E2 (high protection), E3 (medium protection), E4 (low protection).</rdfs:comment>
        <rdfs:label xml:lang="en">lighting zone</rdfs:label>
        <rdfs:label xml:lang="es">zona de alumbrado</rdfs:label>
    </owl:ObjectProperty>
    


