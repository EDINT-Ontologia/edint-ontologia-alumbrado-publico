# =============================================================================
# QUERY: CQ-LUM-03
# Question: ¿Cuál es el número medio de lux por tipo de espacio público?
# Note: La iluminancia media (lux) no está modelada directamente en la ontología.
# Se calcularía a partir del flujo luminoso, la altura y la geometría de la vía.
# Esta consulta es un placeholder para cuando se disponga de datos de lux.
# =============================================================================

PREFIX edintalu: <http://vocab.linkeddata.es/datosabiertos/def/urbanismo-infraestructuras/alumbrado-publico#>
PREFIX xsd:      <http://www.w3.org/2001/XMLSchema#>

# -----------------------------------------------------------------------------
# Placeholder: Número medio de lux por tipo de espacio público
# Requiere una propiedad de iluminancia media o datos externos de cálculo
# lumínico. La ontología actual modela flujo luminoso y FHS por luminaria,
# pero no iluminancia en suelo (lux).
#
# Si se añade una propiedad edintalu:iluminanciaMedia a la clase Farola:
# -----------------------------------------------------------------------------

# SELECT ?tipoEspacio (AVG(xsd:decimal(?lux)) AS ?iluminanciaMediaLux)
# WHERE {
#   ?farola a edintalu:Farola ;
#           edintalu:tipoEspacio ?tipoEspacio ;
#           edintalu:iluminanciaMedia ?lux .
# }
# GROUP BY ?tipoEspacio
# ORDER BY DESC(?iluminanciaMediaLux)

# -----------------------------------------------------------------------------
# Aproximación indirecta: flujo luminoso total por farola en una zona
# (sustituto cuando no hay datos de lux directos)
# -----------------------------------------------------------------------------

SELECT ?farola (SUM(xsd:decimal(?flujo)) AS ?flujoLuminosoTotalLm)
WHERE {
  ?farola a edintalu:Farola ;
          edintalu:luminaria ?lum .
  ?lum edintalu:tieneLampara ?lamp .
  ?lamp edintalu:flujoLuminoso ?flujo .
}
GROUP BY ?farola
ORDER BY DESC(?flujoLuminosoTotalLm)
