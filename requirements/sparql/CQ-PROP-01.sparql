# =============================================================================
# QUERY: CQ-PROP-01
# Question: ¿Quién es el propietario de cada farola?
# =============================================================================

PREFIX edintalu: <http://vocab.linkeddata.es/datosabiertos/def/urbanismo-infraestructuras/alumbrado-publico#>
PREFIX edintinf: <http://vocab.linkeddata.es/datosabiertos/def/urbanismo-infraestructuras/infraestructura#>

# -----------------------------------------------------------------------------
# Propietario registrado de cada farola
# -----------------------------------------------------------------------------

SELECT ?farola ?propietario
WHERE {
  ?farola a edintalu:Farola ;
          edintinf:hasRegisteredOwner ?propietario .
}
ORDER BY ?farola

# -----------------------------------------------------------------------------
# Propietario de cada farola (con nombre del propietario)
# -----------------------------------------------------------------------------

SELECT ?farola ?nombrePropietario
WHERE {
  ?farola a edintalu:Farola ;
          edintinf:hasRegisteredOwner ?propietario .
  ?propietario a edintinf:Organization ;
               edintalu:nombre ?nombrePropietario .
}
ORDER BY ?nombrePropietario

# -----------------------------------------------------------------------------
# Farolas agrupadas por propietario
# -----------------------------------------------------------------------------

SELECT ?propietario (COUNT(?f) AS ?totalFarolas)
WHERE {
  ?f a edintalu:Farola ;
     edintinf:hasRegisteredOwner ?propietario .
}
GROUP BY ?propietario
ORDER BY DESC(?totalFarolas)
