# =============================================================================
# FACT: FAC-10
# Statement: La potencia puede venir en W o kW y debe normalizarse
# Verification: Comprobar unidades QUDT usadas en potenciaNominal
# =============================================================================

PREFIX edintalu: <http://vocab.linkeddata.es/datosabiertos/def/urbanismo-infraestructuras/alumbrado-publico#>
PREFIX qudt:     <http://qudt.org/schema/qudt/>
PREFIX qudtu:    <http://qudt.org/vocab/unit/>

# -----------------------------------------------------------------------------
# La ontología define potenciaNominal con rango qudt:QuantityValue
# Verificar qué unidades se usan en los datos de instancia
# -----------------------------------------------------------------------------

SELECT ?unit (COUNT(?qval) AS ?total)
WHERE {
  ?lamp a edintalu:Lampara ;
         edintalu:potenciaNominal ?qval .
  ?qval a qudt:QuantityValue ;
        qudt:hasUnit ?unit .
}
GROUP BY ?unit

# -----------------------------------------------------------------------------
# Lámparas con potenciaNominal usando unidad W
# -----------------------------------------------------------------------------

SELECT ?lampara ?val
WHERE {
  ?lampara a edintalu:Lampara ;
           edintalu:potenciaNominal ?qv .
  ?qv a qudt:QuantityValue ;
      qudt:numericValue ?val ;
      qudt:hasUnit qudtu:W .
}

# -----------------------------------------------------------------------------
# Lámparas con potenciaNominal usando unidad KiloW
# -----------------------------------------------------------------------------

SELECT ?lampara ?val
WHERE {
  ?lampara a edintalu:Lampara ;
           edintalu:potenciaNominal ?qv .
  ?qv a qudt:QuantityValue ;
      qudt:numericValue ?val ;
      qudt:hasUnit qudtu:KiloW .
}
