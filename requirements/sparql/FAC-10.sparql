# =============================================================================
# FACT: FAC-10
# Statement: La potencia puede venir en W o kW y debe normalizarse
# Verification: Comprobar coherencia de unidades QUDT en potenciaNominal
# =============================================================================

PREFIX edintalu: <http://vocab.linkeddata.es/datosabiertos/def/urbanismo-infraestructuras/alumbrado-publico#>
PREFIX qudt:     <http://qudt.org/schema/qudt/>
PREFIX qudtu:    <http://qudt.org/vocab/unit/>

# -----------------------------------------------------------------------------
# La ontología declara applicableUnit para W y KiloW en potenciaNominal
# -----------------------------------------------------------------------------

ASK {
  edintalu:potenciaNominal qudt:applicableUnit qudtu:W .
  edintalu:potenciaNominal qudt:applicableUnit qudtu:KiloW .
}

# -----------------------------------------------------------------------------
# Si los datos usan qudt:QuantityValue para potencia:
# instancias con unidad W vs KiloW
# -----------------------------------------------------------------------------

SELECT ?unit (COUNT(?qval) AS ?total)
WHERE {
  ?lamp a edintalu:Lampara ;
         edintalu:potenciaNominal ?qval .
  ?qval a qudt:QuantityValue ;
        qudt:hasUnit ?unit .
}
GROUP BY ?unit
