# =============================================================================
# QUERY: CQ-INV-02
# Question: ¿Cuál es la densidad de farolas por km² y distrito?
# Note: Requiere dato externo de superficie del distrito
# =============================================================================

PREFIX edintalu: <http://vocab.linkeddata.es/datosabiertos/def/urbanismo-infraestructuras/alumbrado-publico#>
PREFIX esdir:    <http://vocab.linkeddata.es/datosabiertos/def/urbanismo-infraestructuras/direccion-postal#>

# -----------------------------------------------------------------------------
# Conteo de farolas por distrito (para calcular densidad, dividir por
# superficie del distrito obtenida de fuente externa)
# -----------------------------------------------------------------------------

SELECT ?distrito (COUNT(?f) AS ?totalFarolas)
WHERE {
  ?f a edintalu:Farola ;
     edintalu:direccion ?addr .
  ?addr esdir:distrito ?distrito .
}
GROUP BY ?distrito
ORDER BY DESC(?totalFarolas)

# -----------------------------------------------------------------------------
# Densidad si se dispone de superficie (en km²) como dato asociado al distrito
# -----------------------------------------------------------------------------

PREFIX edintalu: <http://vocab.linkeddata.es/datosabiertos/def/urbanismo-infraestructuras/alumbrado-publico#>
PREFIX esdir:    <http://vocab.linkeddata.es/datosabiertos/def/urbanismo-infraestructuras/direccion-postal#>
PREFIX xsd:      <http://www.w3.org/2001/XMLSchema#>

SELECT ?distrito (COUNT(?f) AS ?totalFarolas) ?superficieKm2
       (xsd:decimal(COUNT(?f)) / ?superficieKm2 AS ?densidadFarolasPorKm2)
WHERE {
  ?f a edintalu:Farola ;
     edintalu:direccion ?addr .
  ?addr esdir:distrito ?distrito .
  ?distrito <http://vocab.linkeddata.es/datosabiertos/def/sector-publico/territorio#areaKm2> ?superficieKm2 .
}
GROUP BY ?distrito ?superficieKm2
ORDER BY DESC(?densidadFarolasPorKm2)
