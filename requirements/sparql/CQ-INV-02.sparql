# =============================================================================
# QUERY: CQ-INV-02
# Question: ¿Cuál es la densidad de farolas por km² y distrito?
# Note: Requiere dato externo de superficie del distrito
# =============================================================================

PREFIX edintalu: <https://edint.es/def/alumbrado-publico#>
PREFIX schema:  <https://schema.org/>

# -----------------------------------------------------------------------------
# Conteo de farolas por distrito (para calcular densidad, dividir por
# superficie del distrito obtenida de fuente externa)
# -----------------------------------------------------------------------------

SELECT ?distrito (COUNT(?f) AS ?totalFarolas)
WHERE {
  ?f a edintalu:Streetlight ;
     edintalu:address ?addr .
  ?addr schema:addressRegion ?distrito .
}
GROUP BY ?distrito
ORDER BY DESC(?totalFarolas)

# -----------------------------------------------------------------------------
# VARIANTE (documentada, no ejecutable tal cual): requiere superficie del
# distrito como dato externo (territorio:areaKm2 no modelado en este repo).
# -----------------------------------------------------------------------------
