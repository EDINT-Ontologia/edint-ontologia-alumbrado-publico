# =============================================================================
# QUERY: CQ-LUM-01
# Question: ¿Qué farolas superan el FHS máximo para su zona E1-E4?
# =============================================================================

PREFIX edintalu: <http://vocab.linkeddata.es/datosabiertos/def/urbanismo-infraestructuras/alumbrado-publico#>
PREFIX skos:     <http://www.w3.org/2004/02/skos/core#>
PREFIX xsd:      <http://www.w3.org/2001/XMLSchema#>

# -----------------------------------------------------------------------------
# Farolas cuyo FHS (flujo hemisférico superior) supera el umbral
# máximo permitido para su zona de alumbrado (E1-E4)
#
# Umbrales REEAE (RD 1890/2008):
#   E1: FHS ≤ 1%    (zonas oscuras)
#   E2: FHS ≤ 5%    (zonas de baja luminosidad)
#   E3: FHS ≤ 15%   (zonas de luminosidad media)
#   E4: FHS ≤ 25%   (zonas de alta luminosidad)
# -----------------------------------------------------------------------------

SELECT ?farola ?zonaLabel ?fhs ?umbralMaximo
WHERE {
  ?farola a edintalu:Farola ;
          edintalu:zonaAlumbrado ?zona ;
          edintalu:luminaria ?lum .
  ?lum edintalu:flujoHemisfericoSuperior ?fhs .
  ?zona skos:prefLabel ?zonaLabel .
  FILTER(LANG(?zonaLabel) = "es")

  # Umbrales según zona (valores REEAE)
  BIND(
    IF(CONTAINS(STR(?zonaLabel), "E1"), 1,
    IF(CONTAINS(STR(?zonaLabel), "E2"), 5,
    IF(CONTAINS(STR(?zonaLabel), "E3"), 15,
    IF(CONTAINS(STR(?zonaLabel), "E4"), 25, 100))))
    AS ?umbralMaximo
  )

  FILTER(xsd:decimal(?fhs) > ?umbralMaximo)
}
ORDER BY ?zonaLabel ?farola

# -----------------------------------------------------------------------------
# Versión alternativa usando la URI del concepto SKOS de zona
# cuando el label no está disponible
# -----------------------------------------------------------------------------

SELECT ?farola ?zona ?fhs
WHERE {
  ?farola a edintalu:Farola ;
          edintalu:zonaAlumbrado ?zona ;
          edintalu:luminaria ?lum .
  ?lum edintalu:flujoHemisfericoSuperior ?fhs .
  FILTER(xsd:decimal(?fhs) > 25)  # Umbral para E4 como ejemplo
}
