# =============================================================================
# FACT: FAC-11
# Statement: Una farola puede disponer de reductor de flujo en la luminaria o al inicio
# Verification: Cardinalidad 0..n (opcional)
# =============================================================================

PREFIX edintalu: <https://edint.es/def/alumbrado-publico#>

# -----------------------------------------------------------------------------
# Farolas con reductor de flujo y tipo (luminaria / inicio)
# -----------------------------------------------------------------------------

SELECT ?farola ?enLuminaria ?enInicio
WHERE {
  ?farola a edintalu:Streetlight ;
          edintalu:hasFlowReducer ?reductor .
  ?reductor edintalu:hasLuminaireFlowReducer ?enLuminaria ;
            edintalu:hasHeadEndFlowReducer ?enInicio .
}
ORDER BY ?farola
