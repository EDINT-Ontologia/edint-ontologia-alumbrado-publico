# =============================================================================
# QUERY: CQ-ENER-03
# Question: ¿Cuántos kWh de fuentes renovables consume el alumbrado público?
# =============================================================================

PREFIX edintalu: <http://vocab.linkeddata.es/datosabiertos/def/urbanismo-infraestructuras/alumbrado-publico#>
PREFIX qudt:     <http://qudt.org/schema/qudt/>
PREFIX xsd:      <http://www.w3.org/2001/XMLSchema#>

# -----------------------------------------------------------------------------
# Total de kWh renovables consumidos por el alumbrado público
# -----------------------------------------------------------------------------

SELECT (SUM(xsd:decimal(?val)) AS ?totalKWhRenovables)
WHERE {
  ?sum a edintalu:SuministroElectrico ;
       edintalu:kwhRenovables ?qv .
  ?qv a qudt:QuantityValue ;
      qudt:numericValue ?val .
}

# -----------------------------------------------------------------------------
# kWh renovables por centro de mando
# -----------------------------------------------------------------------------

SELECT ?centroDeMando ?val
WHERE {
  ?centroDeMando edintalu:tieneSuministro ?sum .
  ?sum a edintalu:SuministroElectrico ;
       edintalu:kwhRenovables ?qv .
  ?qv a qudt:QuantityValue ;
      qudt:numericValue ?val .
}
ORDER BY DESC(?val)
