# =============================================================================
# FACT: FAC-09
# Statement: La potencia se expresa con qudt:QuantityValue (numericValue + hasUnit)
# Verification: Las lámparas con potenciaNominal deben usar qudt:QuantityValue
# =============================================================================

PREFIX edintalu: <https://edint.es/def/alumbrado-publico#>
PREFIX qudt:     <http://qudt.org/schema/qudt/>

# -----------------------------------------------------------------------------
# Lámparas con potenciaNominal que NO usan qudt:QuantityValue
# (Resultado vacío = todas cumplen)
# -----------------------------------------------------------------------------

SELECT ?lampara
WHERE {
  ?lampara a edintalu:Lamp ;
           edintalu:nominalPower ?qv .
  FILTER NOT EXISTS {
    ?qv a qudt:QuantityValue ;
        qudt:numericValue ?val ;
        qudt:hasUnit ?unit .
  }
}
