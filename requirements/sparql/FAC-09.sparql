# =============================================================================
# FACT: FAC-09
# Statement: La potencia se expresa en vatios con qudt:unit
# Verification: Las lámparas con potencia deben tener resultado QUDT
# =============================================================================

PREFIX edintalu: <http://vocab.linkeddata.es/datosabiertos/def/urbanismo-infraestructuras/alumbrado-publico#>

# -----------------------------------------------------------------------------
# Lámparas con potenciaNominal que no usan qudt:applicableUnit
# (Verificación de consistencia de unidades)
# -----------------------------------------------------------------------------

SELECT ?lampara ?potencia
WHERE {
  ?lampara a edintalu:Lampara ;
           edintalu:potenciaNominal ?potencia .
  FILTER NOT EXISTS { edintalu:potenciaNominal <http://qudt.org/schema/qudt#applicableUnit> ?unit . }
}

# -----------------------------------------------------------------------------
# Verificar que la propiedad potenciaNominal tiene applicableUnit declarado
# en la ontología (metadatos, no datos de instancia)
# -----------------------------------------------------------------------------

ASK {
  edintalu:potenciaNominal <http://qudt.org/schema/qudt#applicableUnit> ?unit .
}
