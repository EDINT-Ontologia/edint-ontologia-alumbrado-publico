# =============================================================================
# QUERY: CQ-TEC-04
# Question: ¿Qué modelos de luminaria existen y de qué fabricante?
# =============================================================================

PREFIX edintalu: <https://edint.es/def/alumbrado-publico#>

# -----------------------------------------------------------------------------
# Modelos de luminaria con su fabricante
# -----------------------------------------------------------------------------

SELECT ?modelo ?fabricante
WHERE {
  ?modelo a edintalu:LuminaireModel ;
          edintalu:manufacturedBy ?fabricante .
  ?fabricante a edintalu:Manufacturer .
}
ORDER BY ?modelo

# -----------------------------------------------------------------------------
# Modelos de luminaria (incluyendo los que no tienen fabricante asignado)
# -----------------------------------------------------------------------------

SELECT ?modelo ?fabricante
WHERE {
  ?modelo a edintalu:LuminaireModel .
  OPTIONAL {
    ?modelo edintalu:manufacturedBy ?fab .
    ?fab edintalu:name ?fabricante .
  }
}
ORDER BY ?modelo

# -----------------------------------------------------------------------------
# Número de luminarias por modelo de catálogo
# -----------------------------------------------------------------------------

SELECT ?modelo (COUNT(?lum) AS ?usos)
WHERE {
  ?lum a edintalu:Luminaire ;
       edintalu:luminaireModel ?modelo .
  ?modelo a edintalu:LuminaireModel .
}
GROUP BY ?modelo
ORDER BY DESC(?usos)
