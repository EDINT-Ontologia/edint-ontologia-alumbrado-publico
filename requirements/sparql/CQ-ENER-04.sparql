# =============================================================================
# QUERY: CQ-ENER-04
# Question: ¿Cuál es la proporción de kWh renovables respecto al total?
# =============================================================================

PREFIX edintalu: <https://edint.es/def/alumbrado-publico#>
PREFIX edintsum: <https://edint.es/def/suministro#>
PREFIX sosa:     <http://www.w3.org/ns/sosa/>
PREFIX qudt:     <http://qudt.org/schema/qudt/>
PREFIX qudtu:    <http://qudt.org/vocab/unit/>
PREFIX xsd:      <http://www.w3.org/2001/XMLSchema#>

# -----------------------------------------------------------------------------
# Proporción de kWh renovables respecto al consumo total por centro de mando
# -----------------------------------------------------------------------------

SELECT ?centroDeMando
       ?kwhRenVal
       ?consumoTotalKWh
       (xsd:decimal(?kwhRenVal) / ?consumoTotalKWh * 100 AS ?porcentajeRenovable)
WHERE {
  ?centroDeMando edintalu:hasSupply ?sum .
  ?sum edintalu:renewableKwh ?kwhRenQv .
  ?kwhRenQv qudt:numericValue ?kwhRenVal .
  ?sum edintalu:hasConsumption ?consumo .
  ?consumo a edintalu:EnergyConsumption ;
           sosa:hasResult ?result .
  ?result qudt:numericValue ?value ;
          qudt:hasUnit qudtu:KiloW-HR .
  {
    SELECT ?centroDeMando (SUM(xsd:decimal(?v)) AS ?consumoTotalKWh)
    WHERE {
      ?centroDeMando edintalu:hasSupply ?sum2 .
      ?sum2 edintalu:hasConsumption ?cons2 .
      ?cons2 a edintalu:EnergyConsumption ;
             sosa:hasResult ?res2 .
      ?res2 qudt:numericValue ?v ;
            qudt:hasUnit qudtu:KiloW-HR .
    }
    GROUP BY ?centroDeMando
  }
}
ORDER BY DESC(?porcentajeRenovable)
