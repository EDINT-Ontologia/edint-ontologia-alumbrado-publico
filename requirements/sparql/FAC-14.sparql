# =============================================================================
# FACT: FAC-14
# Statement: Una farola mixta LED-DESCARGA se modela con múltiples luminarias
# Verification: Farolas con más de 1 luminaria son mixtas
# =============================================================================

PREFIX edintalu: <https://edint.es/def/alumbrado-publico#>
PREFIX skos:     <http://www.w3.org/2004/02/skos/core#>

# -----------------------------------------------------------------------------
# Farolas con múltiples luminarias (mixtas LED + descarga)
# -----------------------------------------------------------------------------

SELECT ?farola (GROUP_CONCAT(DISTINCT ?tipoLabel; separator=" + ") AS ?tiposLampara) (COUNT(?lum) AS ?numLuminarias)
WHERE {
  ?farola a edintalu:Streetlight ;
          edintalu:luminaire ?lum .
  ?lum edintalu:hasLamp ?lamp .
  ?lamp edintalu:lampType ?tipoURI .
  ?tipoURI skos:prefLabel ?tipoLabel .
  FILTER(LANG(?tipoLabel) = "es")
}
GROUP BY ?farola
HAVING (COUNT(?lum) > 1)
