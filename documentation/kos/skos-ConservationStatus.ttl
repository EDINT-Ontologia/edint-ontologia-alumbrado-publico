@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix dct: <http://purl.org/dc/terms/> .
@prefix cc: <http://creativecommons.org/ns#> .
@prefix edintkos: <http://vocab.linkeddata.es/datosabiertos/kos/edint/> .
@prefix edintkosconservsta: <http://vocab.linkeddata.es/datosabiertos/kos/edint/ConservationStatus/> .

edintkos:ConservationStatus a skos:ConceptScheme ;
    dct:title "Estado de conservación de farolas"@es , "Streetlight conservation status"@en ;
    dct:creator "FEMP" ;
    dct:issued "2026-05-07"^^<http://www.w3.org/2001/XMLSchema#date> ;
    skos:definition """Estado de conservación de la farola según la metodología EIEL. 
        5 niveles: Excelente, Bueno, Regular, Malo, En ejecución. 
        Basado en Castellón (B/R/M/E) y La Palma (B/R/M)."""@es ;
    skos:definition """Conservation status of the streetlight according to the EIEL methodology. 
        5 levels: Excellent, Good, Regular, Poor, Under construction. 
        Based on Castellón (B/R/M/E) and La Palma (B/R/M)."""@en .

edintkosconservsta:excelente a skos:Concept ;
    skos:inScheme edintkos:ConservationStatus ;
    skos:notation "E" ;
    skos:prefLabel "Excelente"@es , "Excellent"@en ;
    skos:altLabel "E"@es ;
    skos:definition "Farola en perfecto estado de conservación y funcionamiento."@es .

edintkosconservsta:bueno a skos:Concept ;
    skos:inScheme edintkos:ConservationStatus ;
    skos:notation "B" ;
    skos:prefLabel "Bueno"@es , "Good"@en ;
    skos:altLabel "B"@es ;
    skos:definition "Farola en buen estado con desgaste mínimo."@es .

edintkosconservsta:regular a skos:Concept ;
    skos:inScheme edintkos:ConservationStatus ;
    skos:notation "R" ;
    skos:prefLabel "Regular"@es , "Regular"@en ;
    skos:altLabel "R"@es ;
    skos:definition "Farola con desgaste apreciable que precisa mantenimiento preventivo."@es .

edintkosconservsta:malo a skos:Concept ;
    skos:inScheme edintkos:ConservationStatus ;
    skos:notation "M" ;
    skos:prefLabel "Malo"@es , "Poor"@en ;
    skos:altLabel "M"@es ;
    skos:definition "Farola en mal estado que precisa reparación o sustitución."@es .

edintkosconservsta:en-ejecucion a skos:Concept ;
    skos:inScheme edintkos:ConservationStatus ;
    skos:notation "EJ" ;
    skos:prefLabel "En ejecución"@es , "Under construction"@en ;
    skos:altLabel "Ejecución"@es ;
    skos:definition "Farola en proceso de instalación o reforma."@es .
