#################################################################
#    Datatypes
#################################################################

###  http://www.w3.org/2001/XMLSchema#date
xsd:date rdf:type rdfs:Datatype .


###  http://www.w3.org/2001/XMLSchema#gYear
xsd:gYear rdf:type rdfs:Datatype .


#################################################################
#    Object Properties
#################################################################

###  http://vocab.linkeddata.es/datosabiertos/def/urbanismo-infraestructuras/alumbrado-publico#altura
:altura rdf:type owl:ObjectProperty ;
        rdfs:range <http://qudt.org/schema/qudt/QuantityValue> ;
        rdfs:comment "Altura del componente. Aplica a: Poste (altura total), Brazo (altura del brazo sobre el suelo). El valor se expresa como qudt:QuantityValue (qudt:numericValue + qudt:hasUnit), típicamente en metros (M)."@es ,
                     "Height of the component. Applies to: Post (total height), Arm (height of the arm above ground). The value is expressed as qudt:QuantityValue (qudt:numericValue + qudt:hasUnit), typically in meters (M)."@en ;
        rdfs:label "altura"@es ,
                   "height"@en .


###  http://vocab.linkeddata.es/datosabiertos/def/urbanismo-infraestructuras/alumbrado-publico#caja
:caja rdf:type owl:ObjectProperty ;
      rdfs:domain :Farola ;
      rdfs:range :Caja ;
      rdfs:comment "Caja de conexiones de la farola. Cardinalidad: 0..1 (opcional)."@es ,
                   "Junction box of the streetlight. Cardinality: 0..1 (optional)."@en ;
      rdfs:label "caja"@es ,
                 "junction box"@en .


###  http://vocab.linkeddata.es/datosabiertos/def/urbanismo-infraestructuras/alumbrado-publico#centroDeMando
:centroDeMando rdf:type owl:ObjectProperty ;
               rdfs:domain :Farola ;
               rdfs:range :CentroDeMando ;
               rdfs:comment "Centro de mando del que depende la farola."@es ,
                            "Control center on which the streetlight depends."@en ;
               rdfs:label "centro de mando"@es ,
                          "control center"@en .


###  http://vocab.linkeddata.es/datosabiertos/def/urbanismo-infraestructuras/alumbrado-publico#claseLuminotecnica
:claseLuminotecnica rdf:type owl:ObjectProperty ;
                    rdfs:domain :Farola ;
                    rdfs:range <http://www.w3.org/2004/02/skos/core#Concept> ;
                    rdfs:comment "Clase luminotécnica según UNE-EN 13201 que determina los requisitos mínimos de alumbrado. SKOS: A (autopistas), B (arteriales), C (colectoras), D (residenciales), E (peatonales)."@es ,
                                 "Lighting class according to UNE-EN 13201 determining minimum lighting requirements. SKOS: A (motorways), B (arterial), C (collector), D (residential), E (pedestrian)."@en ;
                    rdfs:label "clase luminotécnica"@es ,
                               "road lighting class"@en .


###  http://vocab.linkeddata.es/datosabiertos/def/urbanismo-infraestructuras/alumbrado-publico#direccion
:direccion rdf:type owl:ObjectProperty ;
           rdfs:domain :Farola ;
           rdfs:range <http://vocab.linkeddata.es/datosabiertos/def/urbanismo-infraestructuras/direccion-postal#DireccionPostal> ;
           rdfs:comment "Dirección postal donde se ubica la farola. Se reutiliza esdir:DireccionPostal, que a su vez especializa schema:PostalAddress, vcard:Address y locn:Address."@es ,
                        "Postal address where the streetlight is located. Reuses esdir:DireccionPostal, which specialises schema:PostalAddress, vcard:Address and locn:Address."@en ;
           rdfs:label "address"@en ,
                      "dirección"@es .


###  http://vocab.linkeddata.es/datosabiertos/def/urbanismo-infraestructuras/alumbrado-publico#disponeReductorFlujo
:disponeReductorFlujo rdf:type owl:ObjectProperty ;
                      rdfs:range :ReductorFlujo ;
                      rdfs:comment "Associated flow reducer. Applies to: Streetlight. Cardinality: 0..n."@en ,
                                   "Reductor de flujo asociado. Aplica a: Farola. Cardinalidad: 0..n."@es ;
                      rdfs:label "dispone de reductor de flujo"@es ,
                                 "has flow reducer"@en .


###  http://vocab.linkeddata.es/datosabiertos/def/urbanismo-infraestructuras/alumbrado-publico#estadoConservacion
:estadoConservacion rdf:type owl:ObjectProperty ;
                    rdfs:domain :Farola ;
                    rdfs:range <http://www.w3.org/2004/02/skos/core#Concept> ;
                    rdfs:comment "Conservation status of the streetlight. SKOS with 5 levels: Excellent, Good, Regular, Poor, Under construction."@en ,
                                 "Estado de conservación de la farola. SKOS con 5 niveles: Excelente, Bueno, Regular, Malo, En ejecución."@es ;
                    rdfs:label "conservation status"@en ,
                               "estado de conservación"@es .


###  http://vocab.linkeddata.es/datosabiertos/def/urbanismo-infraestructuras/alumbrado-publico#fabricadoPor
:fabricadoPor rdf:type owl:ObjectProperty ;
              rdfs:range :Fabricante ;
              rdfs:comment "Fabricante del componente. Aplica a: Poste, Luminaria, Lampara, Caja, ModeloLuminaria. Cardinalidad: 0..1."@es ,
                           "Manufacturer of the component. Applies to: Post, Luminaire, Lamp, JunctionBox, LuminaireModel. Cardinality: 0..1."@en ;
              rdfs:label "fabricado por"@es ,
                         "manufactured by"@en .


###  http://vocab.linkeddata.es/datosabiertos/def/urbanismo-infraestructuras/alumbrado-publico#flujoHemisfericoSuperior
:flujoHemisfericoSuperior rdf:type owl:ObjectProperty ;
                          rdfs:domain :Luminaria ;
                          rdfs:range <http://qudt.org/schema/qudt/QuantityValue> ;
                          rdfs:comment "Flujo hemisférico superior (FHS/ULOR) de la luminaria. Clave para el cumplimiento del REEAE en zonas E1-E4. El valor se expresa como qudt:QuantityValue (qudt:numericValue + qudt:hasUnit), típicamente en porcentaje (PERCENT)."@es ,
                                       "Upper hemisphere flux (FHS/ULOR) of the luminaire. Key for REEAE compliance in zones E1-E4. The value is expressed as qudt:QuantityValue (qudt:numericValue + qudt:hasUnit), typically in percent (PERCENT)."@en ;
                          rdfs:label "flujo hemisférico superior"@es ,
                                     "upper hemisphere flux"@en .


###  http://vocab.linkeddata.es/datosabiertos/def/urbanismo-infraestructuras/alumbrado-publico#flujoLuminoso
:flujoLuminoso rdf:type owl:ObjectProperty ;
               rdfs:domain :Lampara ;
               rdfs:range <http://qudt.org/schema/qudt/QuantityValue> ;
               rdfs:comment "Flujo luminoso de la lámpara. El valor se expresa como qudt:QuantityValue (qudt:numericValue + qudt:hasUnit), en lúmenes (LM)."@es ,
                            "Luminous flux of the lamp. The value is expressed as qudt:QuantityValue (qudt:numericValue + qudt:hasUnit), in lumens (LM)."@en ;
               rdfs:label "flujo luminoso"@es ,
                          "luminous flux"@en .


###  http://vocab.linkeddata.es/datosabiertos/def/urbanismo-infraestructuras/alumbrado-publico#intensidadLuminica
:intensidadLuminica rdf:type owl:ObjectProperty ;
                    rdfs:domain :Lampara ;
                    rdfs:range <http://qudt.org/schema/qudt/QuantityValue> ;
                    rdfs:comment "Intensidad lumínica de la lámpara. El valor se expresa como qudt:QuantityValue (qudt:numericValue + qudt:hasUnit), en candelas (CD)."@es ,
                                 "Luminous intensity of the lamp. The value is expressed as qudt:QuantityValue (qudt:numericValue + qudt:hasUnit), in candelas (CD)."@en ;
                    rdfs:label "intensidad lumínica"@es ,
                               "luminous intensity"@en .


###  http://vocab.linkeddata.es/datosabiertos/def/urbanismo-infraestructuras/alumbrado-publico#kwhRenovables
:kwhRenovables rdf:type owl:ObjectProperty ;
               rdfs:domain :SuministroElectrico ;
               rdfs:range <http://qudt.org/schema/qudt/QuantityValue> ;
               rdfs:comment "Consumo de fuentes de energía renovable con sistemas de autoconsumo. El valor se expresa como qudt:QuantityValue (qudt:numericValue + qudt:hasUnit), en kilovatios-hora (KiloW-HR)."@es ,
                            "Consumption from renewable energy sources with self-consumption systems. The value is expressed as qudt:QuantityValue (qudt:numericValue + qudt:hasUnit), in kilowatt-hours (KiloW-HR)."@en ;
               rdfs:label "kWh renovables"@es ,
                          "renewable kWh"@en .


###  http://vocab.linkeddata.es/datosabiertos/def/urbanismo-infraestructuras/alumbrado-publico#luminaria
:luminaria rdf:type owl:ObjectProperty ;
           rdfs:domain :Farola ;
           rdfs:range :Luminaria ;
           rdfs:comment "Aparato de iluminación de la farola. Cardinalidad: 1 o más (caso LED+DESCARGA)."@es ,
                        "Lighting apparatus of the streetlight. Cardinality: 1 or more (e.g., LED+DISCHARGE)."@en ;
           rdfs:label "luminaire"@en ,
                      "luminaria"@es .


###  http://vocab.linkeddata.es/datosabiertos/def/urbanismo-infraestructuras/alumbrado-publico#modeloLuminaria
:modeloLuminaria rdf:type owl:ObjectProperty ;
                 rdfs:domain :Luminaria ;
                 rdfs:range :ModeloLuminaria ;
                 rdfs:comment "Reference to the luminaire's catalog model. Cardinality: 0..1."@en ,
                              "Referencia al modelo de catálogo de la luminaria. Cardinalidad: 0..1."@es ;
                 rdfs:label "luminaire model"@en ,
                            "modelo de luminaria"@es .


###  http://vocab.linkeddata.es/datosabiertos/def/urbanismo-infraestructuras/alumbrado-publico#periodoTarifario
:periodoTarifario rdf:type owl:ObjectProperty ;
                  rdfs:domain :ConsumoEnergetico ;
                  rdfs:range <http://www.w3.org/2004/02/skos/core#Concept> ;
                  rdfs:comment "Período tarifario al que corresponde el consumo. SKOS: activo, llano, valle, punta. Cada instancia de ConsumoEnergetico representa UN período tarifario; el total se obtiene sumando las instancias del mismo ejercicio."@es ,
                               "Tariff period to which the consumption corresponds. SKOS: active, standard, off-peak, peak. Each ConsumoEnergetico instance represents ONE tariff period; the total is obtained by summing instances of the same fiscal year."@en ;
                  rdfs:label "período tarifario"@es ,
                             "tariff period"@en .


###  http://vocab.linkeddata.es/datosabiertos/def/urbanismo-infraestructuras/alumbrado-publico#poste
:poste rdf:type owl:ObjectProperty ;
       rdfs:domain :Farola ;
       rdfs:range :Poste ;
       rdfs:comment "Physical support of the streetlight. Cardinality: exactly 1."@en ,
                    "Soporte físico de la farola. Cardinalidad: exactamente 1."@es ;
       rdfs:label "post"@en ,
                  "poste"@es .


###  http://vocab.linkeddata.es/datosabiertos/def/urbanismo-infraestructuras/alumbrado-publico#potenciaNominal
:potenciaNominal rdf:type owl:ObjectProperty ;
                 rdfs:domain :Lampara ;
                 rdfs:range <http://qudt.org/schema/qudt/QuantityValue> ;
                 rdfs:comment "Nominal power of the lamp. The value is expressed as qudt:QuantityValue (qudt:numericValue + qudt:hasUnit), in watts (W) or kilowatts (KiloW)."@en ,
                              "Potencia nominal de la lámpara. El valor se expresa como qudt:QuantityValue (qudt:numericValue + qudt:hasUnit), en vatios (W) o kilovatios (KiloW)."@es ;
                 rdfs:label "nominal power"@en ,
                            "potencia nominal"@es .


###  http://vocab.linkeddata.es/datosabiertos/def/urbanismo-infraestructuras/alumbrado-publico#temperaturaColor
:temperaturaColor rdf:type owl:ObjectProperty ;
                  rdfs:domain :Lampara ;
                  rdfs:range <http://qudt.org/schema/qudt/QuantityValue> ;
                  rdfs:comment "Correlated color temperature (CCT) of the lamp. The value is expressed as qudt:QuantityValue (qudt:numericValue + qudt:hasUnit), in kelvin (K)."@en ,
                               "Temperatura de color correlacionada (CCT) de la lámpara. El valor se expresa como qudt:QuantityValue (qudt:numericValue + qudt:hasUnit), en kelvin (K)."@es ;
                  rdfs:label "correlated color temperature"@en ,
                             "temperatura de color"@es .


###  http://vocab.linkeddata.es/datosabiertos/def/urbanismo-infraestructuras/alumbrado-publico#tension
:tension rdf:type owl:ObjectProperty ;
         rdfs:domain :SuministroElectrico ;
         rdfs:range <http://qudt.org/schema/qudt/QuantityValue> ;
         rdfs:comment "Supply voltage. The value is expressed as qudt:QuantityValue (qudt:numericValue + qudt:hasUnit), in volts (V)."@en ,
                      "Tensión de alimentación del suministro. El valor se expresa como qudt:QuantityValue (qudt:numericValue + qudt:hasUnit), en voltios (V)."@es ;
         rdfs:label "tensión"@es ,
                    "voltage"@en .


###  http://vocab.linkeddata.es/datosabiertos/def/urbanismo-infraestructuras/alumbrado-publico#tieneBrazo
:tieneBrazo rdf:type owl:ObjectProperty ;
            rdfs:domain :Poste ;
            rdfs:range :Brazo ;
            rdfs:comment "Arm of the post. Cardinality: 0..n."@en ,
                         "Brazo del poste. Cardinalidad: 0..n."@es ;
            rdfs:label "has arm"@en ,
                       "tiene brazo"@es .


###  http://vocab.linkeddata.es/datosabiertos/def/urbanismo-infraestructuras/alumbrado-publico#tieneConsumo
:tieneConsumo rdf:type owl:ObjectProperty ;
              rdfs:domain :SuministroElectrico ;
              rdfs:range :ConsumoEnergetico ;
              rdfs:comment "Energy consumption record of the supply. Cardinality: 0..n."@en ,
                           "Registro de consumo energético del suministro. Cardinalidad: 0..n."@es ;
              rdfs:label "has consumption"@en ,
                         "tiene consumo"@es .


###  http://vocab.linkeddata.es/datosabiertos/def/urbanismo-infraestructuras/alumbrado-publico#tieneLampara
:tieneLampara rdf:type owl:ObjectProperty ;
              rdfs:domain :Luminaria ;
              rdfs:range :Lampara ;
              rdfs:comment "Lamp housed in the luminaire. Cardinality: exactly 1."@en ,
                           "Lámpara alojada en la luminaria. Cardinalidad: exactamente 1."@es ;
              rdfs:label "has lamp"@en ,
                         "tiene lámpara"@es .


###  http://vocab.linkeddata.es/datosabiertos/def/urbanismo-infraestructuras/alumbrado-publico#tieneSuministro
:tieneSuministro rdf:type owl:ObjectProperty ;
                 rdfs:domain :CentroDeMando ;
                 rdfs:range :SuministroElectrico ;
                 rdfs:comment "Contrato de suministro eléctrico asociado al centro de mando. Cardinalidad: 0..1."@es ,
                              "Electricity supply contract associated with the control center. Cardinality: 0..1."@en ;
                 rdfs:label "has supply"@en ,
                            "tiene suministro"@es .


###  http://vocab.linkeddata.es/datosabiertos/def/urbanismo-infraestructuras/alumbrado-publico#tipoAlimentacion
:tipoAlimentacion rdf:type owl:ObjectProperty ;
                  rdfs:domain :Farola ;
                  rdfs:range <http://www.w3.org/2004/02/skos/core#Concept> ;
                  rdfs:comment "Tipo de alimentación eléctrica. SKOS con 5 conceptos (Subterránea, Aérea, Fachada, Grapada, Batería)."@es ,
                               "Type of electrical supply. SKOS with 5 concepts (Underground, Aerial, Wall, Stapled, Battery)."@en ;
                  rdfs:label "power supply type"@en ,
                             "tipo de alimentación"@es .


###  http://vocab.linkeddata.es/datosabiertos/def/urbanismo-infraestructuras/alumbrado-publico#tipoAlumbrado
:tipoAlumbrado rdf:type owl:ObjectProperty ;
               rdfs:domain :Farola ;
               rdfs:range <http://www.w3.org/2004/02/skos/core#Concept> ;
               rdfs:comment "Clase de alumbrado según EN 13201. SKOS: S1-S4, CE2-CE4, ME3C-ME5."@es ,
                            "Lighting class according to EN 13201. SKOS: S1-S4, CE2-CE4, ME3C-ME5."@en ;
               rdfs:label "illumination class"@en ,
                          "tipo de alumbrado"@es .


###  http://vocab.linkeddata.es/datosabiertos/def/urbanismo-infraestructuras/alumbrado-publico#tipoCable
:tipoCable rdf:type owl:ObjectProperty ;
           rdfs:domain :Caja ;
           rdfs:range <http://www.w3.org/2004/02/skos/core#Concept> ;
           rdfs:comment "Cable type in the junction box. SKOS: ET103, ET106, ET107, ET112, ET113."@en ,
                        "Tipo de cable en la caja de conexiones. SKOS: ET103, ET106, ET107, ET112, ET113."@es ;
           rdfs:label "cable type"@en ,
                      "tipo de cable"@es .


###  http://vocab.linkeddata.es/datosabiertos/def/urbanismo-infraestructuras/alumbrado-publico#tipoIluminacion
:tipoIluminacion rdf:type owl:ObjectProperty ;
                 rdfs:domain :Farola ;
                 rdfs:range <http://www.w3.org/2004/02/skos/core#Concept> ;
                 rdfs:comment "Tipo de iluminación. SKOS: Nocturna, Permanente."@es ,
                              "Type of illumination. SKOS: Nighttime, Permanent."@en ;
                 rdfs:label "illumination type"@en ,
                            "tipo de iluminación"@es .


###  http://vocab.linkeddata.es/datosabiertos/def/urbanismo-infraestructuras/alumbrado-publico#tipoLampara
:tipoLampara rdf:type owl:ObjectProperty ;
             rdfs:domain :Lampara ;
             rdfs:range <http://www.w3.org/2004/02/skos/core#Concept> ;
             rdfs:comment "Tipo de lámpara. SKOS con 12 conceptos (LED, Vapor sodio, Vapor mercurio, Halogenuro metálico, etc.)."@es ,
                          "Type of lamp. SKOS with 12 concepts (LED, Sodium vapor, Mercury vapor, Metal halide, etc.)."@en ;
             rdfs:label "lamp type"@en ,
                        "tipo de lámpara"@es .


###  http://vocab.linkeddata.es/datosabiertos/def/urbanismo-infraestructuras/alumbrado-publico#tipoLuminaria
:tipoLuminaria rdf:type owl:ObjectProperty ;
               rdfs:domain :Luminaria ;
               rdfs:range <http://www.w3.org/2004/02/skos/core#Concept> ;
               rdfs:comment "Tipo de luminaria. SKOS con 8 conceptos (Proyector, Empotrado pared, Baliza, Viaria, Artística, etc.)."@es ,
                            "Type of luminaire. SKOS with 8 concepts (Projector, Recessed wall, Bollard, Road, Artistic, etc.)."@en ;
               rdfs:label "luminaire type"@en ,
                          "tipo de luminaria"@es .


###  http://vocab.linkeddata.es/datosabiertos/def/urbanismo-infraestructuras/alumbrado-publico#tipoSoporte
:tipoSoporte rdf:type owl:ObjectProperty ;
             rdfs:domain :Poste ;
             rdfs:range <http://www.w3.org/2004/02/skos/core#Concept> ;
             rdfs:comment "Tipo de soporte físico del poste. SKOS con ~35 conceptos. ConceptScheme: tipo-soporte."@es ,
                          "Type of physical support of the post. SKOS with ~35 concepts. ConceptScheme: tipo-soporte."@en ;
             rdfs:label "support type"@en ,
                        "tipo de soporte"@es .


###  http://vocab.linkeddata.es/datosabiertos/def/urbanismo-infraestructuras/alumbrado-publico#vidaUtilL70
:vidaUtilL70 rdf:type owl:ObjectProperty ;
             rdfs:domain :Lampara ;
             rdfs:range <http://qudt.org/schema/qudt/QuantityValue> ;
             rdfs:comment "Rated life of the lamp at 70% maintained flux (L70). The value is expressed as qudt:QuantityValue (qudt:numericValue + qudt:hasUnit), in hours (HR)."@en ,
                          "Vida útil nominal de la lámpara al 70% de flujo mantenido (L70). El valor se expresa como qudt:QuantityValue (qudt:numericValue + qudt:hasUnit), en horas (HR)."@es ;
             rdfs:label "rated life L70"@en ,
                        "vida útil L70"@es .


###  http://vocab.linkeddata.es/datosabiertos/def/urbanismo-infraestructuras/alumbrado-publico#vidaUtilL80
:vidaUtilL80 rdf:type owl:ObjectProperty ;
             rdfs:domain :Lampara ;
             rdfs:range <http://qudt.org/schema/qudt/QuantityValue> ;
             rdfs:comment "Rated life of the lamp at 80% maintained flux (L80). The value is expressed as qudt:QuantityValue (qudt:numericValue + qudt:hasUnit), in hours (HR)."@en ,
                          "Vida útil nominal de la lámpara al 80% de flujo mantenido (L80). El valor se expresa como qudt:QuantityValue (qudt:numericValue + qudt:hasUnit), en horas (HR)."@es ;
             rdfs:label "rated life L80"@en ,
                        "vida útil L80"@es .


###  http://vocab.linkeddata.es/datosabiertos/def/urbanismo-infraestructuras/alumbrado-publico#zonaAlumbrado
:zonaAlumbrado rdf:type owl:ObjectProperty ;
               rdfs:domain :Farola ;
               rdfs:range <http://www.w3.org/2004/02/skos/core#Concept> ;
               rdfs:comment "Clasificación de zona según REEAE (RD 1890/2008) para control de contaminación lumínica. SKOS: E1 (protección máxima), E2 (protección alta), E3 (protección media), E4 (protección baja)."@es ,
                            "Zone classification according to REEAE (RD 1890/2008) for light pollution control. SKOS: E1 (maximum protection), E2 (high protection), E3 (medium protection), E4 (low protection)."@en ;
               rdfs:label "lighting zone"@en ,
                          "zona de alumbrado"@es .


###  http://vocab.linkeddata.es/datosabiertos/def/urbanismo-infraestructuras/infraestructura#hasInfrastructureType
<http://vocab.linkeddata.es/datosabiertos/def/urbanismo-infraestructuras/infraestructura#hasInfrastructureType> rdf:type owl:ObjectProperty .


#################################################################
#    Data properties
#################################################################

###  http://vocab.linkeddata.es/datosabiertos/def/urbanismo-infraestructuras/alumbrado-publico#accesorios
:accesorios rdf:type owl:DatatypeProperty ;
            rdfs:domain :Poste ;
            rdfs:range xsd:string ;
            rdfs:comment "Accesorios montados en el poste (medidores, cámaras, etc.)."@es ,
                         "Accessories mounted on the post (meters, cameras, etc.)."@en ;
            rdfs:label "accesorios"@es ,
                       "accessories"@en .


###  http://vocab.linkeddata.es/datosabiertos/def/urbanismo-infraestructuras/alumbrado-publico#calidadDato
:calidadDato rdf:type owl:DatatypeProperty ;
             rdfs:domain :Farola ;
             rdfs:range xsd:string ;
             rdfs:comment "Calidad del dato: B (buena), R (regular), M (mala), E (en ejecución)."@es ,
                          "Data quality: B (good), R (regular), M (poor), E (under construction)."@en ;
             rdfs:label "calidad del dato"@es ,
                        "data quality"@en .


###  http://vocab.linkeddata.es/datosabiertos/def/urbanismo-infraestructuras/alumbrado-publico#eficaciaLuminosa
:eficaciaLuminosa rdf:type owl:DatatypeProperty ;
                  rdfs:domain :Lampara ;
                  rdfs:range xsd:decimal ;
                  rdfs:comment "Eficacia luminosa de la lámpara en lúmenes por vatio (lm/W)."@es ,
                               "Luminous efficacy of the lamp in lumens per watt (lm/W)."@en ;
                  rdfs:label "eficacia luminosa"@es ,
                             "luminous efficacy"@en .


###  http://vocab.linkeddata.es/datosabiertos/def/urbanismo-infraestructuras/alumbrado-publico#ejercicio
:ejercicio rdf:type owl:DatatypeProperty ;
           rdfs:range xsd:gYear ;
           rdfs:comment "Año de referencia de los datos. Aplica a: ConsumoEnergetico, SuministroElectrico."@es ,
                        "Reference year of the data. Applies to: ConsumoEnergetico, SuministroElectrico."@en ;
           rdfs:label "ejercicio"@es ,
                      "fiscal year"@en .


###  http://vocab.linkeddata.es/datosabiertos/def/urbanismo-infraestructuras/alumbrado-publico#esReductorFlujoInicio
:esReductorFlujoInicio rdf:type owl:DatatypeProperty ;
                       rdfs:domain :ReductorFlujo ;
                       rdfs:range xsd:boolean ;
                       rdfs:comment "Indica si dispone de sistema de reducción de flujo al inicio de la instalación (regulador de cabecera)."@es ,
                                    "Indicates whether a flow reduction system is available at the start of the installation (head-end regulator)."@en ;
                       rdfs:label "es reductor de flujo al inicio"@es ,
                                  "is head-end flow reducer"@en .


###  http://vocab.linkeddata.es/datosabiertos/def/urbanismo-infraestructuras/alumbrado-publico#esReductorFlujoLuminaria
:esReductorFlujoLuminaria rdf:type owl:DatatypeProperty ;
                          rdfs:domain :ReductorFlujo ;
                          rdfs:range xsd:boolean ;
                          rdfs:comment "Indica si dispone de sistema de reducción de flujo en la luminaria."@es ,
                                       "Indicates whether a flow reduction system is available in the luminaire."@en ;
                          rdfs:label "es reductor de flujo en luminaria"@es ,
                                     "is luminaire flow reducer"@en .


###  http://vocab.linkeddata.es/datosabiertos/def/urbanismo-infraestructuras/alumbrado-publico#fechaInstalacion
:fechaInstalacion rdf:type owl:DatatypeProperty ;
                  rdfs:domain :Lampara ;
                  rdfs:range xsd:dateTime ;
                  rdfs:comment "Fecha de instalación de la lámpara."@es ,
                               "Installation date of the lamp."@en ;
                  rdfs:label "fecha de instalación"@es ,
                             "installation date"@en .


###  http://vocab.linkeddata.es/datosabiertos/def/urbanismo-infraestructuras/alumbrado-publico#horasDeFuncionamiento
:horasDeFuncionamiento rdf:type owl:DatatypeProperty ;
                       rdfs:domain :Farola ;
                       rdfs:range xsd:string ;
                       rdfs:comment "Horario en que el alumbrado está encendido (ej: '22:00-07:00')."@es ,
                                    "Schedule when the lighting is on (e.g., '22:00-07:00')."@en ;
                       rdfs:label "horas de funcionamiento"@es ,
                                  "operating hours"@en .


###  http://vocab.linkeddata.es/datosabiertos/def/urbanismo-infraestructuras/alumbrado-publico#indiceReproduccionCromatica
:indiceReproduccionCromatica rdf:type owl:DatatypeProperty ;
                             rdfs:domain :Lampara ;
                             rdfs:range xsd:decimal ;
                             rdfs:comment "Color rendering index (CRI) of the lamp (0-100)."@en ,
                                          "Índice de reproducción cromática (CRI/IRC) de la lámpara (0-100)."@es ;
                             rdfs:label "color rendering index"@en ,
                                        "índice de reproducción cromática"@es .


###  http://vocab.linkeddata.es/datosabiertos/def/urbanismo-infraestructuras/alumbrado-publico#material
:material rdf:type owl:DatatypeProperty ;
          rdfs:range xsd:string ;
          rdfs:comment "Material del componente. Aplica a: Poste, Luminaria, Lampara, Caja."@es ,
                       "Material of the component. Applies to: Post, Luminaire, Lamp, JunctionBox."@en ;
          rdfs:label "material"@en ,
                     "material"@es .


###  http://vocab.linkeddata.es/datosabiertos/def/urbanismo-infraestructuras/alumbrado-publico#metodoDeControl
:metodoDeControl rdf:type owl:DatatypeProperty ;
                 rdfs:domain :Farola ;
                 rdfs:range xsd:string ;
                 rdfs:comment "Method for switching the lighting on/off (astronomical clock, photocell, remote management, etc.)."@en ,
                              "Método de activación/desactivación del alumbrado (reloj astronómico, fotocélula, telegestión, etc.)."@es ;
                 rdfs:label "control method"@en ,
                            "método de control"@es .


###  http://vocab.linkeddata.es/datosabiertos/def/urbanismo-infraestructuras/alumbrado-publico#modeloBombilla
:modeloBombilla rdf:type owl:DatatypeProperty ;
                rdfs:domain :Lampara ;
                rdfs:range xsd:string ;
                rdfs:comment "Code or model of the bulb."@en ,
                             "Código o modelo de la bombilla."@es ;
                rdfs:label "bulb model"@en ,
                           "modelo de bombilla"@es .


###  http://vocab.linkeddata.es/datosabiertos/def/urbanismo-infraestructuras/alumbrado-publico#nombre
:nombre rdf:type owl:DatatypeProperty ;
        rdfs:range xsd:string ;
        rdfs:comment "Name of the entity. Applies to: ControlCenter, Manufacturer, Owner, LuminaireModel."@en ,
                     "Nombre de la entidad. Aplica a: CentroDeMando, Fabricante, ModeloLuminaria."@es ;
        rdfs:label "name"@en ,
                   "nombre"@es .


###  http://vocab.linkeddata.es/datosabiertos/def/urbanismo-infraestructuras/alumbrado-publico#numeroDeBrazos
:numeroDeBrazos rdf:type owl:DatatypeProperty ;
                rdfs:domain :Poste ;
                rdfs:range xsd:integer ;
                rdfs:comment "Número total de brazos del poste."@es ,
                             "Total number of arms of the post."@en ;
                rdfs:label "number of arms"@en ,
                           "número de brazos"@es .


###  http://vocab.linkeddata.es/datosabiertos/def/urbanismo-infraestructuras/alumbrado-publico#numeroDeLuminarias
:numeroDeLuminarias rdf:type owl:DatatypeProperty ;
                    rdfs:domain :Farola ;
                    rdfs:range xsd:integer ;
                    rdfs:comment "Number of luminaires in the streetlight."@en ,
                                 "Número de luminarias en la farola."@es ;
                    rdfs:label "number of luminaires"@en ,
                               "número de luminarias"@es .


###  http://vocab.linkeddata.es/datosabiertos/def/urbanismo-infraestructuras/alumbrado-publico#observaciones
:observaciones rdf:type owl:DatatypeProperty ;
               rdfs:range xsd:string ;
               rdfs:comment "Notes about the streetlight or component. Applies to: Streetlight, Post, Luminaire, Lamp, JunctionBox."@en ,
                            "Observaciones sobre la farola o componente. Aplica a: Farola, Poste, Luminaria, Lampara, Caja."@es ;
               rdfs:label "notes"@en ,
                          "observaciones"@es .


###  http://vocab.linkeddata.es/datosabiertos/def/urbanismo-infraestructuras/alumbrado-publico#ordenBrazo
:ordenBrazo rdf:type owl:DatatypeProperty ;
            rdfs:domain :Brazo ;
            rdfs:range xsd:integer ;
            rdfs:comment "Ordinal position of the arm on the post (1, 2, 3...)."@en ,
                         "Posición ordinal del brazo en el poste (1, 2, 3...)."@es ;
            rdfs:label "arm order"@en ,
                       "orden del brazo"@es .


###  http://vocab.linkeddata.es/datosabiertos/def/urbanismo-infraestructuras/alumbrado-publico#tarifa
:tarifa rdf:type owl:DatatypeProperty ;
        rdfs:domain :SuministroElectrico ;
        rdfs:range xsd:string ;
        rdfs:comment "Tipo de tarifa eléctrica aplicada (ej: 6.1, 6.2, 6.3, 6.4)."@es ,
                     "Type of electricity tariff applied (e.g., 6.1, 6.2, 6.3, 6.4)."@en ;
        rdfs:label "tarifa"@es ,
                   "tariff"@en .


#################################################################
#    Classes
#################################################################

###  http://qudt.org/schema/qudt/QuantityValue
<http://qudt.org/schema/qudt/QuantityValue> rdf:type owl:Class .


###  http://vocab.linkeddata.es/datosabiertos/def/urbanismo-infraestructuras/alumbrado-publico#Brazo
:Brazo rdf:type owl:Class ;
       rdfs:comment "Arm of the post that supports a luminaire. A post can have multiple arms, each with its own height."@en ,
                    "Brazo del poste que soporta una luminaria. Un poste puede tener múltiples brazos, cada uno con su propia altura."@es ;
       rdfs:label "Arm"@en ,
                  "Brazo"@es .


###  http://vocab.linkeddata.es/datosabiertos/def/urbanismo-infraestructuras/alumbrado-publico#Caja
:Caja rdf:type owl:Class ;
      rdfs:comment "Caja de conexiones o registro de acceso a los cables eléctricos de la farola. Opcional: no todas las farolas tienen una caja accesible."@es ,
                   "Junction box or access point for the streetlight's electrical cables. Optional: not all streetlights have an accessible box."@en ;
      rdfs:label "Caja"@es ,
                 "Junction Box"@en .


###  http://vocab.linkeddata.es/datosabiertos/def/urbanismo-infraestructuras/alumbrado-publico#CentroDeMando
:CentroDeMando rdf:type owl:Class ;
               rdfs:subClassOf <http://vocab.linkeddata.es/datosabiertos/def/urbanismo-infraestructuras/suministro#UtilitySupplyPoint> ;
               rdfs:comment "Cuadro eléctrico o centro de control del que dependen una o más farolas. Es un punto de suministro (edintsum:UtilitySupplyPoint), punto donde llega la electricidad a la instalación de alumbrado."@es ,
                            "Electrical panel or control center on which one or more streetlights depend. It is a utility supply point (edintsum:UtilitySupplyPoint), the point where electricity reaches the lighting installation."@en ;
               rdfs:label "Centro de mando"@es ,
                          "Control Center"@en .


###  http://vocab.linkeddata.es/datosabiertos/def/urbanismo-infraestructuras/alumbrado-publico#ConsumoEnergetico
:ConsumoEnergetico rdf:type owl:Class ;
                   rdfs:subClassOf <http://vocab.linkeddata.es/datosabiertos/def/urbanismo-infraestructuras/suministro#UtilityConsumption> ;
                   rdfs:comment "Observación de consumo eléctrico en un período tarifario determinado. Al heredar de edintsum:UtilityConsumption ⊂ sosa:Observation, usa el patrón SOSA: – sosa:hasFeatureOfInterest → el CentroDeMando (punto de suministro) – sosa:observedProperty → edintsum:electricityConsumption – sosa:hasResult → qudt:QuantityValue (qudt:numericValue + qudt:hasUnit) – edintalu:periodoTarifario → concepto SKOS (activo, llano, valle, punta) Cada instancia representa el consumo en UN período tarifario. El total se obtiene sumando las instancias del mismo ejercicio."@es ,
                                "Observation of electricity consumption in a specific tariff period. By inheriting from edintsum:UtilityConsumption ⊂ sosa:Observation, uses the SOSA pattern: – sosa:hasFeatureOfInterest → the CentroDeMando (supply point) – sosa:observedProperty → edintsum:electricityConsumption – sosa:hasResult → qudt:QuantityValue (qudt:numericValue + qudt:hasUnit) – edintalu:periodoTarifario → SKOS concept (active, standard, off-peak, peak) Each instance represents consumption in ONE tariff period. The total is obtained by summing instances of the same fiscal year."@en ;
                   rdfs:label "Consumo energético"@es ,
                              "Energy Consumption"@en .


###  http://vocab.linkeddata.es/datosabiertos/def/urbanismo-infraestructuras/alumbrado-publico#Fabricante
:Fabricante rdf:type owl:Class ;
            rdfs:comment "Entidad que fabrica componentes del alumbrado (postes, luminarias, lámparas, cajas o modelos)."@es ,
                         "Entity that manufactures street lighting components (posts, luminaires, lamps, boxes or models)."@en ;
            rdfs:label "Fabricante"@es ,
                       "Manufacturer"@en .


###  http://vocab.linkeddata.es/datosabiertos/def/urbanismo-infraestructuras/alumbrado-publico#Farola
:Farola rdf:type owl:Class ;
        rdfs:subClassOf <http://vocab.linkeddata.es/datosabiertos/def/urbanismo-infraestructuras/infraestructura#UrbanElement> ,
                        [ rdf:type owl:Restriction ;
                          owl:onProperty <http://vocab.linkeddata.es/datosabiertos/def/urbanismo-infraestructuras/infraestructura#hasInfrastructureType> ;
                          owl:hasValue <http://vocab.linkeddata.es/datosabiertos/kos/edint/InfrastructureType/StreeLamp>
                        ] ;
        rdfs:comment "A complete point of light, composed of a post, one or more luminaires (which in turn contain lamps) and optionally a junction box. It is an urban element (edintinf:UrbanElement) and, by inheritance, an InfrastructureElement that can have a utility supply point (edintsum:hasUtilitySupplyPoint). Every instance of Farola has infrastructure type 'Street lamp' (edintkosinftype:StreeLamp) from the EDINT SKOS."@en ,
                     "Punto de luz completo, compuesto por un poste, una o más luminarias (que a su vez contienen lámparas) y opcionalmente una caja de conexiones. Es un elemento urbano (edintinf:UrbanElement) y, por herencia, un InfrastructureElement que puede tener punto de suministro (edintsum:hasUtilitySupplyPoint). Toda instancia de Farola tiene como tipo de infraestructura 'Street lamp' (edintkosinftype:StreeLamp) del SKOS de EDINT."@es ;
        rdfs:label "Farola"@es ,
                   "Streetlight"@en ;
        rdfs:seeAlso <http://vocab.linkeddata.es/datosabiertos/def/urbanismo-infraestructuras/alumbrado-publico/v1.0-rc/Farola> .


###  http://vocab.linkeddata.es/datosabiertos/def/urbanismo-infraestructuras/alumbrado-publico#Lampara
:Lampara rdf:type owl:Class ;
         rdfs:comment "Fuente de luz: bombilla, módulo LED o convertidor de energía eléctrica en luz. Cada luminaria aloja exactamente una lámpara. Incluye propiedades fotométricas (potencia, flujo, CCT, CRI) y de vida útil (L70, L80)."@es ,
                      "Light source: bulb, LED module or converter of electrical energy into light. Each luminaire houses exactly one lamp. Includes photometric properties (power, luminous flux, CCT, CRI) and rated life (L70, L80)."@en ;
         rdfs:label "Lamp"@en ,
                    "Lámpara"@es .


###  http://vocab.linkeddata.es/datosabiertos/def/urbanismo-infraestructuras/alumbrado-publico#Luminaria
:Luminaria rdf:type owl:Class ;
           rdfs:comment "Aparato de iluminación que aloja, dirige y filtra la luz de la lámpara. Una farola puede tener múltiples luminarias (caso LED+DESCARGA). Puede referenciar un modelo del catálogo (ModeloLuminaria)."@es ,
                        "Lighting apparatus that houses, directs and filters the light from the lamp. A streetlight can have multiple luminaires (e.g., LED+DISCHARGE). Can reference a catalog model (ModeloLuminaria)."@en ;
           rdfs:label "Luminaire"@en ,
                      "Luminaria"@es .


###  http://vocab.linkeddata.es/datosabiertos/def/urbanismo-infraestructuras/alumbrado-publico#ModeloLuminaria
:ModeloLuminaria rdf:type owl:Class ;
                 rdfs:comment "Entrada del catálogo de modelos de luminaria. Permite vincular fabricante, potencia nominal, tecnología y especificaciones fotométricas."@es ,
                              "Entry in the luminaire model catalog. Allows linking manufacturer, nominal power, technology and photometric specifications."@en ;
                 rdfs:label "Luminaire Model"@en ,
                            "Modelo de luminaria"@es .


###  http://vocab.linkeddata.es/datosabiertos/def/urbanismo-infraestructuras/alumbrado-publico#Poste
:Poste rdf:type owl:Class ;
       rdfs:comment "Physical support of the streetlight: column, bracket, wall, short post, etc. The specific type is indicated via tipoSoporte (SKOS). A post can have one or more arms."@en ,
                    "Soporte físico de la farola: columna, báculo, fachada, postelete, etc. El tipo concreto se indica mediante tipoSoporte (SKOS). Un poste puede tener uno o más brazos."@es ;
       rdfs:label "Post"@en ,
                  "Poste"@es .


###  http://vocab.linkeddata.es/datosabiertos/def/urbanismo-infraestructuras/alumbrado-publico#ReductorFlujo
:ReductorFlujo rdf:type owl:Class ;
               rdfs:comment "Energy saving system that reduces luminous flux. Can be located in the luminaire (lamp regulator) or at the start of the installation (head-end regulator)."@en ,
                            "Sistema de ahorro energético que reduce el flujo luminoso. Puede estar ubicado en la luminaria (regulador de lámpara) o al inicio de la instalación (regulador de cabecera)."@es ;
               rdfs:label "Flow Reducer"@en ,
                          "Reductor de flujo"@es .


###  http://vocab.linkeddata.es/datosabiertos/def/urbanismo-infraestructuras/alumbrado-publico#SuministroElectrico
:SuministroElectrico rdf:type owl:Class ;
                     rdfs:subClassOf <http://vocab.linkeddata.es/datosabiertos/def/urbanismo-infraestructuras/suministro#UtilityContract> ;
                     rdfs:comment "Contrato de suministro eléctrico asociado a un centro de mando. Incluye tarifa, tensión y consumo por períodos tarifarios. Es un contrato de suministro (edintsum:UtilityContract), con tarifa y punto de suministro asociado."@es ,
                                  "Electricity supply contract associated with a control center. Includes tariff, voltage, and consumption by tariff periods. It is a utility contract (edintsum:UtilityContract), with rate and associated supply point."@en ;
                     rdfs:label "Electricity Supply"@en ,
                                "Suministro eléctrico"@es .


###  http://vocab.linkeddata.es/datosabiertos/def/urbanismo-infraestructuras/direccion-postal#DireccionPostal
<http://vocab.linkeddata.es/datosabiertos/def/urbanismo-infraestructuras/direccion-postal#DireccionPostal> rdf:type owl:Class ;
                                                                                                           rdfs:comment "Dirección postal en España. Especialización de schema:PostalAddress, vcard:Address y locn:Address. Permite representar la dirección de una farola con propiedades como streetAddress, addressLocality, postalCode, etc."@es ,
                                                                                                                        "Postal address in Spain. Specialisation of schema:PostalAddress, vcard:Address and locn:Address. Allows representing a streetlight's address with properties like streetAddress, addressLocality, postalCode, etc."@en ;
                                                                                                           rdfs:isDefinedBy <http://vocab.linkeddata.es/datosabiertos/def/urbanismo-infraestructuras/direccion-postal> ;
                                                                                                           rdfs:label "Dirección postal"@es ,
                                                                                                                      "Postal address"@en .


###  http://vocab.linkeddata.es/datosabiertos/def/urbanismo-infraestructuras/infraestructura#UrbanElement
<http://vocab.linkeddata.es/datosabiertos/def/urbanismo-infraestructuras/infraestructura#UrbanElement> rdf:type owl:Class .


###  http://vocab.linkeddata.es/datosabiertos/def/urbanismo-infraestructuras/suministro#UtilityConsumption
<http://vocab.linkeddata.es/datosabiertos/def/urbanismo-infraestructuras/suministro#UtilityConsumption> rdf:type owl:Class .


###  http://vocab.linkeddata.es/datosabiertos/def/urbanismo-infraestructuras/suministro#UtilityContract
<http://vocab.linkeddata.es/datosabiertos/def/urbanismo-infraestructuras/suministro#UtilityContract> rdf:type owl:Class .


###  http://vocab.linkeddata.es/datosabiertos/def/urbanismo-infraestructuras/suministro#UtilitySupplyPoint
<http://vocab.linkeddata.es/datosabiertos/def/urbanismo-infraestructuras/suministro#UtilitySupplyPoint> rdf:type owl:Class .


###  http://www.w3.org/2000/01/rdf-schema#Resource
rdfs:Resource rdf:type owl:Class .


###  http://www.w3.org/2004/02/skos/core#Concept
<http://www.w3.org/2004/02/skos/core#Concept> rdf:type owl:Class .


#################################################################
#    Individuals
#################################################################

###  http://qudt.org/vocab/unit/CD
<http://qudt.org/vocab/unit/CD> rdf:type owl:NamedIndividual ,
                                         rdfs:Resource .


###  http://qudt.org/vocab/unit/EUR
<http://qudt.org/vocab/unit/EUR> rdf:type owl:NamedIndividual ,
                                          rdfs:Resource .


###  http://qudt.org/vocab/unit/HR
