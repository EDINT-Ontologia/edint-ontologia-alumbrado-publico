@prefix : <http://vocab.linkeddata.es/datosabiertos/def/urbanismo-infraestructuras/alumbrado-publico#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix xml: <http://www.w3.org/XML/1998/namespace> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@base <http://vocab.linkeddata.es/datosabiertos/def/urbanismo-infraestructuras/alumbrado-publico#> .

<http://vocab.linkeddata.es/datosabiertos/def/urbanismo-infraestructuras/alumbrado-publico> rdf:type owl:Ontology ;
                                                                                             owl:versionIRI <http://vocab.linkeddata.es/datosabiertos/def/urbanismo-infraestructuras/alumbrado-publico/0.1.0> ;
                                                                                             owl:imports <http://www.w3.org/2004/02/skos/core> ;
                                                                                             <http://purl.org/dc/elements/1.1/abstract> "Ontology for representing public street lighting data. Models the modular composition of streetlights, electrical infrastructure, energy consumption, and photometric and light pollution parameters."@en ,
                                                                                                                                        "Ontología para la representación de datos de alumbrado público. Modela la composición modular de farolas, la infraestructura eléctrica, el consumo energético y los parámetros fotométricos y de contaminación lumínica."@es ;
                                                                                             <http://purl.org/dc/elements/1.1/contributor> "Ontology Engineering Group, Universidad Politécnica de Madrid" ;
                                                                                             <http://purl.org/dc/elements/1.1/creator> "Daniel Doña" ,
                                                                                                                                       "Edna Ruckhaus" ,
                                                                                                                                       "Lucía Sánchez" ,
                                                                                                                                       "M. Martín Blázquez" ,
                                                                                                                                       "María Poveda" ,
                                                                                                                                       "Oscar Corcho" ;
                                                                                             <http://purl.org/dc/elements/1.1/description> "Ontology for representing public street lighting data in the context of FEMP (Spanish Federation of Municipalities and Provinces). Models: modular composition of streetlights (post, luminaire, lamp, box), electrical infrastructure (control center), energy consumption as SOSA observation with QUDT result, luminaire model catalog, manufacturer, photometric parameters and light pollution (FHS, zones E1-E4), and conservation status. Measurement units with QUDT."@en ,
                                                                                                                                           "Ontología para la representación de datos de alumbrado público en el contexto de la FEMP. Modela: composición modular de farolas (poste, luminaria, lámpara, caja), infraestructura eléctrica (centro de mando), consumo energético como observación SOSA con resultado QUDT, catálogo de modelos de luminaria, fabricante, parámetros fotométricos y de contaminación lumínica (FHS, zonas E1-E4), y estado de conservación. Unidades de medida con QUDT."@es ;
                                                                                             <http://purl.org/dc/elements/1.1/publisher> "FEMP — Federación Española de Municipios y Provincias" ;
                                                                                             <http://purl.org/dc/elements/1.1/title> "Ontología de Alumbrado Público"@es ,
                                                                                                                                     "Public Street Lighting Ontology"@en ;
                                                                                             <http://purl.org/dc/terms/created> "2026-05-07"^^xsd:date ;
                                                                                             <http://purl.org/dc/terms/license> <https://creativecommons.org/licenses/by/4.0/> ;
                                                                                             <http://purl.org/vocab/vann/preferredNamespacePrefix> "edintalu" ;
                                                                                             <http://purl.org/vocab/vann/preferredNamespaceUri> "http://vocab.linkeddata.es/datosabiertos/def/urbanismo-infraestructuras/alumbrado-publico#" ;
                                                                                             rdfs:comment "Ontology for representing public street lighting data."@en ,
                                                                                                          "Ontología para la representación de datos de alumbrado público."@es ;
                                                                                             rdfs:label "Ontología de Alumbrado Público"@es ,
                                                                                                        "Public Street Lighting Ontology"@en ;
                                                                                             rdfs:seeAlso <https://github.com/opencitydata/urbanismo-infraestructuras-alumbrado-publico> ;
                                                                                             owl:priorVersion <https://raw.githubusercontent.com/opencitydata/urbanismo-infraestructuras-alumbrado-publico/main/v1.0-rc/ontology/ontology.owl> ;
                                                                                             owl:versionInfo "0.1.0" .

