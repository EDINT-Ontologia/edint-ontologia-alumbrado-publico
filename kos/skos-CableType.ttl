#################################################################
#
#    Concept Scheme
#
#################################################################

edintkos:CableType a skos:ConceptScheme ;
    dct:issued "2026-05-07"^^xsd:date ;
    cc:license <https://creativecommons.org/licenses/by/4.0/> ;
    rdfs:comment "This concept scheme belongs to the set of controlled SKOS-based thesauri used by the ontologies from the EDINT data space."@en ;
    rdfs:comment "Este esquema de conceptos pertenece al conjunto de tesauros SKOS usados por las ontologías del espacio de datos EDINT."@es ;
    rdfs:label "Tipo de cable"@es ;
    rdfs:label "Cable type"@en ;
    dct:title "Concept scheme grouping cable types in streetlight junction boxes according to technical specification."@en ;
    dct:title "Esquema de conceptos agrupando tipos de cable en la caja de conexiones de la farola según especificación técnica."@es ;
    skos:definition "Cable types in the streetlight junction box according to technical specification."@en ;
    skos:definition "Tipos de cable en la caja de conexiones de la farola según especificación técnica."@es .

#################################################################
#
#    Concepts
#
#################################################################

edintcabletype:et103 a skos:Concept ;
    skos:inScheme edintkos:CableType ;
    skos:notation "ET103" ;
    skos:prefLabel "ET103"@es , "ET103"@en ;
    skos:definition "Especificación técnica de cable ET103."@es .

