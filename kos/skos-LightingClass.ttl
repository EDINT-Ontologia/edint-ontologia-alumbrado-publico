@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix dct: <http://purl.org/dc/terms/> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix cc: <http://creativecommons.org/ns#> .
@prefix edintkos: <http://vocab.linkeddata.es/datosabiertos/kos/edint/> .
@prefix edintlightingclass: <http://vocab.linkeddata.es/datosabiertos/kos/edint/LightingClass/> .

#################################################################
#
#    Concept Scheme
#
#################################################################

edintkos:LightingClass a skos:ConceptScheme ;
    dct:issued "2026-05-07"^^xsd:date ;
    cc:license <https://creativecommons.org/licenses/by/4.0/> ;
    rdfs:comment "This concept scheme belongs to the set of controlled SKOS-based thesauri used by the ontologies from the EDINT data space."@en ;
    rdfs:comment "Este esquema de conceptos pertenece al conjunto de tesauros SKOS usados por las ontologías del espacio de datos EDINT."@es ;
    rdfs:label "Clase de alumbrado"@es ;
    rdfs:label "Lighting class"@en ;
    dct:title "Concept scheme grouping road lighting classes according to UNE-EN 13201."@en ;
    dct:title "Esquema de conceptos agrupando clases de alumbrado vial según la norma UNE-EN 13201."@es ;
    skos:definition "Road lighting classes according to UNE-EN 13201. M classes (carriageways), C classes (conflict zones), S classes (pedestrian)."@en ;
    skos:definition "Clases de alumbrado vial según la norma UNE-EN 13201. Clases M (calzadas), C (zonas de conflicto), S (peatonales)."@es .

#################################################################
#
#    Concepts
#
#################################################################

# --- Clases M (calzadas para vehículos) ---

edintlightingclass:m1 a skos:Concept ;
    skos:inScheme edintkos:LightingClass ;
    skos:notation "M1" ;
    skos:prefLabel "M1"@es , "M1"@en ;
    skos:definition "Clase M1 — calzadas de alta velocidad con mucho tráfico."@es .

edintlightingclass:m2 a skos:Concept ;
    skos:inScheme edintkos:LightingClass ;
    skos:notation "M2" ;
    skos:prefLabel "M2"@es , "M2"@en .

