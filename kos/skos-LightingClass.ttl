    skos:inScheme edintkos:LightingClass ;
    skos:notation "M3" ;
    skos:prefLabel "M3"@es , "M3"@en .

edintlightingclass:m4 a skos:Concept ;
    skos:inScheme edintkos:LightingClass ;
    skos:notation "M4" ;
    skos:prefLabel "M4"@es , "M4"@en .

edintlightingclass:m5 a skos:Concept ;
    skos:inScheme edintkos:LightingClass ;
    skos:notation "M5" ;
    skos:prefLabel "M5"@es , "M5"@en .

edintlightingclass:m6 a skos:Concept ;
    skos:inScheme edintkos:LightingClass ;
    skos:notation "M6" ;
    skos:prefLabel "M6"@es , "M6"@en .

