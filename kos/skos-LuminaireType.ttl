@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix dct: <http://purl.org/dc/terms/> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix cc: <http://creativecommons.org/ns#> .
@prefix edintkos: <http://vocab.linkeddata.es/datosabiertos/kos/edint/> .
@prefix edintluminairtype: <http://vocab.linkeddata.es/datosabiertos/kos/edint/LuminaireType/> .

#################################################################
#
#    Concept Scheme
#
#################################################################

edintkos:LuminaireType a skos:ConceptScheme ;
    dct:issued "2026-05-07"^^xsd:date ;
    cc:license <https://creativecommons.org/licenses/by/4.0/> ;
    rdfs:comment "This concept scheme belongs to the set of controlled SKOS-based thesauri used by the ontologies from the EDINT data space."@en ;
    rdfs:comment "Este esquema de conceptos pertenece al conjunto de tesauros SKOS usados por las ontologías del espacio de datos EDINT."@es ;
    rdfs:label "Tipo de luminaria"@es ;
    rdfs:label "Luminaire type"@en ;
    dct:title "Concept scheme grouping types of luminaire by shape and use."@en ;
    dct:title "Esquema de conceptos agrupando tipos de luminaria según su forma y uso."@es ;
    skos:definition "Taxonomy of luminaire types by shape and use. 8 concepts."@en ;
    skos:definition "Taxonomía de tipos de luminaria según su forma y uso. 8 conceptos."@es .

#################################################################
#
#    Concepts
#
#################################################################

edintluminairtype:viaria a skos:Concept ;
    skos:inScheme edintkos:LuminaireType ;
    skos:notation "viaria" ;
    skos:prefLabel "Viaria"@es , "Road"@en ;
    skos:definition "Luminaria diseñada para la iluminación de vías de circulación."@es ;
    skos:definition "Luminaire designed for road lighting."@en .

edintluminairtype:proyector a skos:Concept ;
    skos:inScheme edintkos:LuminaireType ;
    skos:notation "proyector" ;
    skos:prefLabel "Proyector"@es , "Projector"@en ;
    skos:altLabel "Floodlight"@en ;
    skos:definition "Luminaria de haz concentrado para iluminación de grandes superficies."@es .

edintluminairtype:empotrado-pared a skos:Concept ;
    skos:inScheme edintkos:LuminaireType ;
    skos:notation "empotrado-pared" ;
    skos:prefLabel "Empotrado en pared"@es , "Wall recessed"@en ;
    skos:altLabel "Aplique"@es , "Wall-mounted"@en .

edintluminairtype:baliza a skos:Concept ;
    skos:inScheme edintkos:LuminaireType ;
    skos:notation "baliza" ;
    skos:prefLabel "Baliza"@es , "Bollard"@en ;
    skos:definition "Luminaria baja tipo baliza para iluminación peatonal o decorativa."@es .

edintluminairtype:artistica a skos:Concept ;
    skos:inScheme edintkos:LuminaireType ;
    skos:notation "artistica" ;
    skos:prefLabel "Artística"@es , "Artistic"@en ;
    skos:definition "Luminaria con diseño ornamental o histórico."@es .

edintluminairtype:colgante a skos:Concept ;
    skos:inScheme edintkos:LuminaireType ;
    skos:notation "colgante" ;
    skos:prefLabel "Colgante"@es , "Pendant"@en .

edintluminairtype:suspension a skos:Concept ;
    skos:inScheme edintkos:LuminaireType ;
    skos:notation "suspension" ;
    skos:prefLabel "Suspensión"@es , "Suspended"@en ;
    skos:altLabel "Catenaria"@es .

edintluminairtype:techo a skos:Concept ;
    skos:inScheme edintkos:LuminaireType ;
    skos:notation "techo" ;
    skos:prefLabel "Techo"@es , "Ceiling"@en ;
    skos:definition "Luminaria montada en techo o bóveda."@es .
