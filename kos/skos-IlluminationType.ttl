@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix dct: <http://purl.org/dc/terms/> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix cc: <http://creativecommons.org/ns#> .
@prefix edintkos: <http://vocab.linkeddata.es/datosabiertos/kos/edint/> .
@prefix edintillumtype: <http://vocab.linkeddata.es/datosabiertos/kos/edint/IlluminationType/> .

#################################################################
#
#    Concept Scheme
#
#################################################################

edintkos:IlluminationType a skos:ConceptScheme ;
    dct:issued "2026-05-07"^^xsd:date ;
    cc:license <https://creativecommons.org/licenses/by/4.0/> ;
    rdfs:comment "This concept scheme belongs to the set of controlled SKOS-based thesauri used by the ontologies from the EDINT data space."@en ;
    rdfs:comment "Este esquema de conceptos pertenece al conjunto de tesauros SKOS usados por las ontologías del espacio de datos EDINT."@es ;
    rdfs:label "Tipo de iluminación"@es ;
    rdfs:label "Illumination type"@en ;
    dct:title "Concept scheme grouping illumination regime types: nighttime or permanent."@en ;
    dct:title "Esquema de conceptos agrupando tipos de régimen de iluminación: nocturna o permanente."@es ;
    skos:definition "Classification of the illumination regime: nighttime or permanent."@en ;
    skos:definition "Clasificación del régimen de iluminación: nocturna o permanente."@es .

#################################################################
#
#    Concepts
#
#################################################################

edintillumtype:nocturna a skos:Concept ;
    skos:inScheme edintkos:IlluminationType ;
    skos:notation "nocturna" ;
    skos:prefLabel "Nocturna"@es , "Nighttime"@en ;
    skos:definition "Iluminación encendida solo durante las horas nocturnas."@es ;
    skos:definition "Lighting switched on only during nighttime hours."@en .

edintillumtype:permanente a skos:Concept ;
    skos:inScheme edintkos:IlluminationType ;
    skos:notation "permanente" ;
    skos:prefLabel "Permanente"@es , "Permanent"@en ;
    skos:altLabel "24h"@es ;
    skos:definition "Iluminación encendida las 24 horas (túneles, etc.)."@es ;
    skos:definition "Lighting switched on 24 hours (tunnels, etc.)."@en .
