@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix dct: <http://purl.org/dc/terms/> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix cc: <http://creativecommons.org/ns#> .
@prefix edintkos: <http://vocab.linkeddata.es/datosabiertos/kos/edint/> .
@prefix edintsupporttype: <http://vocab.linkeddata.es/datosabiertos/kos/edint/SupportType/> .

#################################################################
#
#    Concept Scheme
#
#################################################################

edintkos:SupportType a skos:ConceptScheme ;
    dct:issued "2026-05-07"^^xsd:date ;
    cc:license <https://creativecommons.org/licenses/by/4.0/> ;
    rdfs:comment "This concept scheme belongs to the set of controlled SKOS-based thesauri used by the ontologies from the EDINT data space."@en ;
    rdfs:comment "Este esquema de conceptos pertenece al conjunto de tesauros SKOS usados por las ontologías del espacio de datos EDINT."@es ;
    rdfs:label "Tipo de soporte"@es ;
    rdfs:label "Support type"@en ;
    dct:title "Concept scheme grouping types of physical support for streetlights."@en ;
    dct:title "Esquema de conceptos agrupando tipos de soporte físico de farolas."@es ;
    skos:definition "Taxonomy of physical support types for streetlights. Expanded from 5 concepts (v1.0-rc) to ~35 based on Tenerife and Navarra."@en ;
    skos:definition "Taxonomía de tipos de soporte físico de farolas. Ampliada de 5 conceptos (v1.0-rc) a ~35 según Tenerife y Navarra."@es .

#################################################################
#
#    Concepts
#
#################################################################

# --- Columna (top-level) ---

edintsupporttype:columna a skos:Concept ;
    skos:inScheme edintkos:SupportType ;
    skos:notation "columna" ;
    skos:prefLabel "Columna"@es , "Column"@en ;
    skos:altLabel "Poste"@es .

edintsupporttype:columna-triconica a skos:Concept ;
    skos:inScheme edintkos:SupportType ;
    skos:broader edintsupporttype:columna ;
    skos:notation "columna-triconica" ;
    skos:prefLabel "Columna troncónica"@es , "Conical column"@en .

edintsupporttype:columna-cilindrica a skos:Concept ;
    skos:inScheme edintkos:SupportType ;
    skos:broader edintsupporttype:columna ;
    skos:notation "columna-cilindrica" ;
    skos:prefLabel "Columna cilíndrica"@es , "Cylindrical column"@en .

edintsupporttype:columna-clasica a skos:Concept ;
    skos:inScheme edintkos:SupportType ;
    skos:broader edintsupporttype:columna ;
    skos:notation "columna-clasica" ;
    skos:prefLabel "Columna clásica"@es , "Classic column"@en .

edintsupporttype:columna-prim a skos:Concept ;
    skos:inScheme edintkos:SupportType ;
    skos:broader edintsupporttype:columna ;
    skos:notation "columna-prim" ;
    skos:prefLabel "Columna prim"@es , "Prim column"@en .

edintsupporttype:columna-nickolson a skos:Concept ;
    skos:inScheme edintkos:SupportType ;
    skos:broader edintsupporttype:columna ;
    skos:notation "columna-nickolson" ;
    skos:prefLabel "Columna Nickolson"@es , "Nickolson column"@en .

edintsupporttype:columna-doble-luminaria a skos:Concept ;
    skos:inScheme edintkos:SupportType ;
    skos:broader edintsupporttype:columna ;
    skos:notation "columna-doble-luminaria" ;
    skos:prefLabel "Columna doble luminaria"@es , "Double luminaire column"@en .

edintsupporttype:columna-diseno a skos:Concept ;
    skos:inScheme edintkos:SupportType ;
    skos:broader edintsupporttype:columna ;
    skos:notation "columna-diseno" ;
    skos:prefLabel "Columna diseño"@es , "Design column"@en .

# --- Báculo (top-level) ---

