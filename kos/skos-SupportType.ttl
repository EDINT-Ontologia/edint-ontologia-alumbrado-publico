# --- Fachada (top-level) ---

edintsupporttype:fachada a skos:Concept ;
    skos:inScheme edintkos:SupportType ;
    skos:notation "fachada" ;
    skos:prefLabel "Fachada"@es , "Wall"@en ;
    skos:altLabel "Pared"@es .

edintsupporttype:brazo-fachada a skos:Concept ;
    skos:inScheme edintkos:SupportType ;
    skos:broader edintsupporttype:fachada ;
    skos:notation "brazo-fachada" ;
    skos:prefLabel "Brazo en fachada"@es , "Wall arm"@en .

edintsupporttype:pared-tunel a skos:Concept ;
    skos:inScheme edintkos:SupportType ;
    skos:broader edintsupporttype:fachada ;
    skos:notation "pared-tunel" ;
    skos:prefLabel "Pared túnel"@es , "Tunnel wall"@en .

# --- Postelete (top-level) ---

edintsupporttype:postelete a skos:Concept ;
    skos:inScheme edintkos:SupportType ;
    skos:notation "postelete" ;
    skos:prefLabel "Postelete"@es , "Short post"@en ;
