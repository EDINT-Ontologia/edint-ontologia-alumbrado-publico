@prefix edintkos: <http://vocab.linkeddata.es/datosabiertos/kos/edint/> .
@prefix edintkossupport: <http://vocab.linkeddata.es/datosabiertos/kos/edint/SupportType/> .

edintkos:SupportType a skos:ConceptScheme ;
    dct:title "Tipos de soporte de alumbrado público"@es , "Public lighting support types"@en ;
    dct:creator "FEMP" ;
    dct:issued "2026-05-07"^^<http://www.w3.org/2001/XMLSchema#date> ;
    skos:definition "Taxonomía de tipos de soporte físico de farolas. Ampliada de 5 conceptos (v1.0-rc) a ~35 según Tenerife y Navarra."@es ;
    skos:definition "Taxonomy of physical support types for streetlights. Expanded from 5 concepts (v1.0-rc) to ~35 based on Tenerife and Navarra."@en .

# --- Conceptos ---

