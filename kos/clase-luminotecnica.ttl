@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix dc: <http://purl.org/dc/elements/1.1/> .
@prefix dcterms: <http://purl.org/dc/terms/> .

<http://vocab.linkeddata.es/datosabiertos/kos/urbanismo-infraestructuras/alumbrado-publico/clase-luminotecnica> a skos:ConceptScheme ;
    dc:title "Clases luminotécnicas según EN 13201"@es , "Lighting classes according to EN 13201"@en ;
    dc:creator "FEMP" ;
    dcterms:created "2026-05-07"^^<http://www.w3.org/2001/XMLSchema#date> ;
    skos:definition """Clasificación luminotécnica según la norma UNE-EN 13201 para determinar 
        los requisitos mínimos de alumbrado. 
        A: autopistas, B: arteriales, C: colectoras, D: residenciales, E: peatonales."""@es ;
    skos:definition """Classification of lighting class according to UNE-EN 13201 for determining 
        minimum lighting requirements. 
        A: motorways, B: arterial, C: collector, D: residential, E: pedestrian."""@en .

<http://vocab.linkeddata.es/datosabiertos/kos/urbanismo-infraestructuras/alumbrado-publico/clase-luminotecnica/a> a skos:Concept ;
    skos:inScheme <http://vocab.linkeddata.es/datosabiertos/kos/urbanismo-infraestructuras/alumbrado-publico/clase-luminotecnica> ;
    skos:notation "A" ;
    skos:prefLabel "Clase A"@es , "Class A"@en ;
    skos:altLabel "Autopista"@es , "Motorway"@en ;
    skos:definition "Vías de alta velocidad y tráfico denso: autopistas y autovías."@es ;
    skos:definition "High-speed, high-traffic roads: motorways and expressways."@en .

<http://vocab.linkeddata.es/datosabiertos/kos/urbanismo-infraestructuras/alumbrado-publico/clase-luminotecnica/b> a skos:Concept ;
    skos:inScheme <http://vocab.linkeddata.es/datosabiertos/kos/urbanismo-infraestructuras/alumbrado-publico/clase-luminotecnica> ;
    skos:notation "B" ;
    skos:prefLabel "Clase B"@es , "Class B"@en ;
    skos:altLabel "Arterial"@es , "Arterial"@en ;
    skos:definition "Vías de velocidad media-alta: calles arteriales urbanas principales."@es ;
    skos:definition "Medium-high speed roads: main urban arterial streets."@en .

<http://vocab.linkeddata.es/datosabiertos/kos/urbanismo-infraestructuras/alumbrado-publico/clase-luminotecnica/c> a skos:Concept ;
    skos:inScheme <http://vocab.linkeddata.es/datosabiertos/kos/urbanismo-infraestructuras/alumbrado-publico/clase-luminotecnica> ;
    skos:notation "C" ;
    skos:prefLabel "Clase C"@es , "Class C"@en ;
    skos:altLabel "Colectora"@es , "Collector"@en ;
    skos:definition "Vías de velocidad media: calles colectoras que distribuyen tráfico entre arteriales y residenciales."@es ;
    skos:definition "Medium speed roads: collector streets distributing traffic between arterial and residential."@en .

<http://vocab.linkeddata.es/datosabiertos/kos/urbanismo-infraestructuras/alumbrado-publico/clase-luminotecnica/d> a skos:Concept ;
    skos:inScheme <http://vocab.linkeddata.es/datosabiertos/kos/urbanismo-infraestructuras/alumbrado-publico/clase-luminotecnica> ;
    skos:notation "D" ;
    skos:prefLabel "Clase D"@es , "Class D"@en ;
    skos:altLabel "Residencial"@es , "Residential"@en ;
    skos:definition "Vías de velocidad baja: calles residenciales con acceso a viviendas."@es ;
    skos:definition "Low speed roads: residential streets with housing access."@en .

<http://vocab.linkeddata.es/datosabiertos/kos/urbanismo-infraestructuras/alumbrado-publico/clase-luminotecnica/e> a skos:Concept ;
    skos:inScheme <http://vocab.linkeddata.es/datosabiertos/kos/urbanismo-infraestructuras/alumbrado-publico/clase-luminotecnica> ;
    skos:notation "E" ;
    skos:prefLabel "Clase E"@es , "Class E"@en ;
    skos:altLabel "Peatonal"@es , "Pedestrian"@en ;
    skos:definition "Vías de velocidad muy baja: zonas peatonales, aceras, plazas y parques."@es ;
    skos:definition "Very low speed areas: pedestrian zones, sidewalks, squares and parks."@en .
