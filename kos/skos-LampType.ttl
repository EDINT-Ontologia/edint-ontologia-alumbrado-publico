@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix dct: <http://purl.org/dc/terms/> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix cc: <http://creativecommons.org/ns#> .
@prefix edintkos: <http://vocab.linkeddata.es/datosabiertos/kos/edint/> .
@prefix edintlamptype: <http://vocab.linkeddata.es/datosabiertos/kos/edint/LampType/> .

#################################################################
#
#    Concept Scheme
#
#################################################################

edintkos:LampType a skos:ConceptScheme ;
    dct:issued "2026-05-07"^^xsd:date ;
    cc:license <https://creativecommons.org/licenses/by/4.0/> ;
    rdfs:comment "This concept scheme belongs to the set of controlled SKOS-based thesauri used by the ontologies from the EDINT data space."@en ;
    rdfs:comment "Este esquema de conceptos pertenece al conjunto de tesauros SKOS usados por las ontologías del espacio de datos EDINT."@es ;
    rdfs:label "Tipo de lámpara"@es ;
    rdfs:label "Lamp type"@en ;
    dct:title "Concept scheme grouping lamp types (light source technology) for public lighting."@en ;
    dct:title "Esquema de conceptos agrupando tipos de lámpara (tecnología de fuente de luz) para alumbrado público."@es ;
    skos:definition "Taxonomy of lamp types (light source technology). 12 concepts."@en ;
    skos:definition "Taxonomía de tipos de lámpara (tecnología de fuente de luz). 12 conceptos."@es .

#################################################################
#
#    Concepts
#
#################################################################

# --- LED ---

edintlamptype:led a skos:Concept ;
    skos:inScheme edintkos:LampType ;
    skos:notation "led" ;
    skos:prefLabel "LED"@es , "LED"@en ;
    skos:altLabel "Diodo emisor de luz"@es , "Light Emitting Diode"@en ;
    skos:definition "Lámpara de diodos emisores de luz (estado sólido)."@es .

# --- Descarga (categoría padre) ---

edintlamptype:descarga a skos:Concept ;
    skos:inScheme edintkos:LampType ;
    skos:notation "descarga" ;
    skos:prefLabel "Descarga"@es , "Discharge"@en ;
    skos:definition "Lámpara de descarga en gas (categoría general)."@es .

edintlamptype:vapor-sodio-alta-presion a skos:Concept ;
    skos:inScheme edintkos:LampType ;
    skos:broader edintlamptype:descarga ;
    skos:notation "vsap" ;
    skos:prefLabel "Vapor de sodio alta presión"@es , "High-pressure sodium vapor"@en ;
    skos:altLabel "VSAP"@es , "HPS"@en .

edintlamptype:vapor-sodio-baja-presion a skos:Concept ;
    skos:inScheme edintkos:LampType ;
    skos:broader edintlamptype:descarga ;
    skos:notation "vsbp" ;
    skos:prefLabel "Vapor de sodio baja presión"@es , "Low-pressure sodium vapor"@en ;
    skos:altLabel "VSBP"@es , "LPS"@en .

edintlamptype:vapor-mercurio a skos:Concept ;
    skos:inScheme edintkos:LampType ;
    skos:broader edintlamptype:descarga ;
    skos:notation "vm" ;
    skos:prefLabel "Vapor de mercurio"@es , "Mercury vapor"@en ;
    skos:altLabel "VM"@es , "MV"@en .

edintlamptype:halogenuro-metalico a skos:Concept ;
    skos:inScheme edintkos:LampType ;
    skos:broader edintlamptype:descarga ;
    skos:notation "hm" ;
    skos:prefLabel "Halogenuro metálico"@es , "Metal halide"@en ;
    skos:altLabel "HM"@es , "MH"@en .

# --- Mixta ---

edintlamptype:led-descarga a skos:Concept ;
    skos:inScheme edintkos:LampType ;
    skos:notation "led-descarga" ;
    skos:prefLabel "LED-Descarga"@es , "LED-Discharge"@en ;
    skos:definition "Farola con luminarias mixtas LED y descarga (0.6% en Madrid)."@es .

# --- Incandescencia ---

edintlamptype:incandescente a skos:Concept ;
    skos:inScheme edintkos:LampType ;
    skos:notation "incandescente" ;
    skos:prefLabel "Incandescente"@es , "Incandescent"@en .

edintlamptype:halogen a skos:Concept ;
    skos:inScheme edintkos:LampType ;
    skos:notation "halogena" ;
    skos:prefLabel "Halógena"@es , "Halogen"@en .

# --- Fluorescente ---

edintlamptype:fluorescente a skos:Concept ;
    skos:inScheme edintkos:LampType ;
    skos:notation "fluorescente" ;
    skos:prefLabel "Fluorescente"@es , "Fluorescent"@en .

edintlamptype:induccion a skos:Concept ;
    skos:inScheme edintkos:LampType ;
    skos:notation "induccion" ;
    skos:prefLabel "Inducción"@es , "Induction"@en ;
    skos:altLabel "Fluorescente por inducción"@es .

# --- Sin lámpara ---

edintlamptype:sin-lampara a skos:Concept ;
    skos:inScheme edintkos:LampType ;
    skos:notation "sin-lampara" ;
    skos:prefLabel "Sin lámpara"@es , "No lamp"@en .
