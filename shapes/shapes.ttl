    sh:targetClass :Lamp .

<https://astrea.linkeddata.es/shapes#930f3f3770efbef27719d16436e6e6f5> a sh:NodeShape ;
    rdfs:label "Energy Consumption"@en,
        "Consumo energético"@es ;
    sh:description "Observation of electricity consumption in a specific tariff period. By inheriting from edintsum:UtilityConsumption ⊂ sosa:Observation, uses the SOSA pattern: – sosa:hasFeatureOfInterest → the CentroDeMando (supply point) – sosa:observedProperty → edintsum:electricityConsumption – sosa:hasResult → qudt:QuantityValue (qudt:numericValue + qudt:hasUnit) – edintalu:tariffPeriod → SKOS concept (active, standard, off-peak, peak) Each instance represents consumption in ONE tariff period. The total is obtained by summing instances of the same fiscal year."@en,
        "Observación de consumo eléctrico en un período tarifario determinado. Al heredar de edintsum:UtilityConsumption ⊂ sosa:Observation, usa el patrón SOSA: – sosa:hasFeatureOfInterest → el CentroDeMando (punto de suministro) – sosa:observedProperty → edintsum:electricityConsumption – sosa:hasResult → qudt:QuantityValue (qudt:numericValue + qudt:hasUnit) – edintalu:tariffPeriod → concepto SKOS (activo, llano, valle, punta) Cada instancia representa el consumo en UN período tarifario. El total se obtiene sumando las instancias del mismo ejercicio."@es ;
    sh:name "Energy Consumption"@en,
        "Consumo energético"@es ;
    sh:nodeKind sh:IRI ;
    sh:property <https://astrea.linkeddata.es/shapes#51e0e8f19f0663f609c6d7e1181dfeb8> ;
    sh:targetClass :EnergyConsumption .

