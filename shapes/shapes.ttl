<https://astrea.linkeddata.es/shapes#ad822eccfab7eb1964e501fb03b47967> a sh:NodeShape ;
    rdfs:label "Control Center"@en,
        "Centro de mando"@es ;
    sh:description "Electrical panel or control center on which one or more streetlights depend. It is a utility supply point (edintsum:UtilitySupplyPoint), the point where electricity reaches the lighting installation."@en,
        "Cuadro eléctrico o centro de control del que dependen una o más farolas. Es un punto de suministro (edintsum:UtilitySupplyPoint), punto donde llega la electricidad a la instalación de alumbrado."@es ;
    sh:name "Control Center"@en,
        "Centro de mando"@es ;
    sh:nodeKind sh:IRI ;
    sh:property <https://astrea.linkeddata.es/shapes#c9316e1a1859c34cc4c4ad821e95e2aa> ;
    sh:targetClass :ControlCenter .

