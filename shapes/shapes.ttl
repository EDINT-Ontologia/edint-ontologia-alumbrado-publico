        <https://astrea.linkeddata.es/shapes#98a5031e888bc0cb23a243da1b4a918c> ;
    sh:targetClass :Luminaire .

<https://astrea.linkeddata.es/shapes#8c9900de1b8b5874498f0b3dc13a371b> a sh:NodeShape ;
    rdfs:label "Lamp"@en,
        "Lámpara"@es ;
    sh:description "Light source: bulb, LED module or converter of electrical energy into light. Each luminaire houses exactly one lamp. Includes photometric properties (power, luminous flux, CCT, CRI) and rated life (L70, L80)."@en,
        "Fuente de luz: bombilla, módulo LED o convertidor de energía eléctrica en luz. Cada luminaria aloja exactamente una lámpara. Incluye propiedades fotométricas (potencia, flujo, CCT, CRI) y de vida útil (L70, L80)."@es ;
    sh:name "Lamp"@en,
        "Lámpara"@es ;
    sh:nodeKind sh:IRI ;
    sh:property <https://astrea.linkeddata.es/shapes#135da652aa178c6be2d9571ad5b97c1e>,
        <https://astrea.linkeddata.es/shapes#16eea60f3b01feed18eff9e9daf0127a>,
        <https://astrea.linkeddata.es/shapes#2044677975e6d9aca7cd2e4cca71d938>,
        <https://astrea.linkeddata.es/shapes#8516711ce517ebc8a91109946466e781>,
        <https://astrea.linkeddata.es/shapes#90df37974d1d2baaf7dd91e0401035cf>,
        <https://astrea.linkeddata.es/shapes#94d52328242bb2aeeb93b156eaa3c9f6>,
        <https://astrea.linkeddata.es/shapes#a9cf8309ba3dd63f31cf82d3bfd9da73>,
        <https://astrea.linkeddata.es/shapes#b1524b5b3ee7cb38a78febbf84c5fa92>,
        <https://astrea.linkeddata.es/shapes#e1c0d170632640bf0a6a2b6dcc4256f0>,
        <https://astrea.linkeddata.es/shapes#fb76579a5ad1f41c91cb6938c05861e4>,
