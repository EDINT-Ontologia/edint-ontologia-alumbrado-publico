        <https://astrea.linkeddata.es/shapes#9a43e4890cbd6ea188a60f13761c9097>,
        <https://astrea.linkeddata.es/shapes#a4348cda6f943e4dff5318f91cc17f06>,
        <https://astrea.linkeddata.es/shapes#a94b0043bcc94660e1059ee27f103290>,
