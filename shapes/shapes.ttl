<https://astrea.linkeddata.es/shapes#7fa0ba7763b13982e81c9807c4a629f4> a sh:NodeShape ;
    rdfs:label "Luminaire"@en,
        "Luminaria"@es ;
    sh:description "Lighting apparatus that houses, directs and filters the light from the lamp. A streetlight can have multiple luminaires (e.g., LED+DISCHARGE). Can reference a catalog model (ModeloLuminaria)."@en,
        "Aparato de iluminación que aloja, dirige y filtra la luz de la lámpara. Una farola puede tener múltiples luminarias (caso LED+DESCARGA). Puede referenciar un modelo del catálogo (ModeloLuminaria)."@es ;
    sh:name "Luminaire"@en,
        "Luminaria"@es ;
    sh:nodeKind sh:IRI ;
    sh:property <https://astrea.linkeddata.es/shapes#1e53bd62d3cb6535faa11faf9a7ccd2b>,
        <https://astrea.linkeddata.es/shapes#23e419692d3d25358a397e3f16a75407>,
