<https://astrea.linkeddata.es/shapes#ee7b43b90f9c4e187ea5bea285667936> a sh:NodeShape ;
    rdfs:label "Streetlight"@en,
        "Farola"@es ;
    rdfs:seeAlso <https://edint.es/def/alumbrado-publico#v1.0-rc/Streetlight> ;
    sh:description "A complete point of light, composed of a post, one or more luminaires (which in turn contain lamps) and optionally a junction box. It is an urban element (edintinf:UrbanElement) and, by inheritance, an InfrastructureElement that can have a utility supply point (edintsum:hasUtilitySupplyPoint). Every instance of Farola has infrastructure type 'Street lamp' (edintkosinftype:StreeLamp) from the EDINT SKOS."@en,
        "Punto de luz completo, compuesto por un poste, una o más luminarias (que a su vez contienen lámparas) y opcionalmente una caja de conexiones. Es un elemento urbano (edintinf:UrbanElement) y, por herencia, un InfrastructureElement que puede tener punto de suministro (edintsum:hasUtilitySupplyPoint). Toda instancia de Farola tiene como tipo de infraestructura 'Street lamp' (edintkosinftype:StreeLamp) del SKOS de EDINT."@es ;
    sh:name "Streetlight"@en,
        "Farola"@es ;
    sh:nodeKind sh:IRI ;
    sh:property <https://astrea.linkeddata.es/shapes#0d9eb514f83c8026d8a5f517d8edd1ff>,
        <https://astrea.linkeddata.es/shapes#330766b0e336769db99ecf87bf589b23>,
