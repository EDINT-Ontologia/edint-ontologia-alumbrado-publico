@prefix ex: <http://example.org/generico/alumbrado/> .
@prefix edintalu: <http://vocab.linkeddata.es/datosabiertos/def/urbanismo-infraestructuras/alumbrado-publico#> .
@prefix edintinf: <http://vocab.linkeddata.es/datosabiertos/def/urbanismo-infraestructuras/infraestructura#> .
@prefix edintsum: <http://vocab.linkeddata.es/datosabiertos/def/urbanismo-infraestructuras/suministro#> .
@prefix edintkosinftype: <http://vocab.linkeddata.es/datosabiertos/kos/edint/InfrastructureType/> .
@prefix esdir: <http://vocab.linkeddata.es/datosabiertos/def/urbanismo-infraestructuras/direccion-postal#> .
@prefix gsp: <http://www.opengis.net/ont/geosparql#> .
@prefix sosa: <http://www.w3.org/ns/sosa/> .
@prefix qudt: <http://qudt.org/schema/qudt/> .
@prefix qudtu: <http://qudt.org/vocab/unit/> .
@prefix schema: <http://schema.org/> .
@prefix dct: <http://purl.org/dc/terms/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

#################################################################
# Ejemplo genérico: Farola completa con todos los elementos del modelo
# No corresponde a un dataset real — ilustra la máxima extensión
# del modelo: poste, luminaria, lámpara, caja, fabricante, propietario,
# parámetros fotométricos, FHS, zona de alumbrado, clase luminotécnica,
# estado de conservación, reductor de flujo, centro de mando,
# suministro eléctrico y consumo energético (SOSA).
#################################################################

# --- Centro de mando ---

ex:cm-001 a edintalu:ControlCenter ;
    edintalu:name "CM-001" ;
    edintalu:hasSupply ex:suministro-001 .

# --- Suministro eléctrico ---

ex:suministro-001 a edintalu:ElectricitySupply ;
    edintalu:fiscalYear "2024"^^xsd:gYear ;
    edintalu:tariff "6.1" ;
    edintalu:voltage [ a qudt:QuantityValue ; qudt:numericValue 230 ; qudt:hasUnit qudtu:V ] ;
    edintalu:renewableKwh [ a qudt:QuantityValue ; qudt:numericValue 1200 ; qudt:hasUnit qudtu:KiloW-HR ] ;
    edintalu:hasConsumption ex:consumo-001-llano , ex:consumo-001-valle .

# --- Consumo energético (SOSA) ---

ex:consumo-001-llano a edintalu:EnergyConsumption ;
    sosa:hasFeatureOfInterest ex:cm-001 ;
    sosa:observedProperty edintsum:electricityConsumption ;
    sosa:hasResult [ a qudt:QuantityValue ;
                     qudt:numericValue 8500 ;
                     qudt:hasUnit qudtu:KiloW-HR ] ;
    edintalu:tariffPeriod <http://vocab.linkeddata.es/datosabiertos/kos/edint/TariffPeriod/llano> ;
    edintalu:fiscalYear "2024"^^xsd:gYear .

ex:consumo-001-valle a edintalu:EnergyConsumption ;
    sosa:hasFeatureOfInterest ex:cm-001 ;
    sosa:observedProperty edintsum:electricityConsumption ;
    sosa:hasResult [ a qudt:QuantityValue ;
                     qudt:numericValue 4200 ;
                     qudt:hasUnit qudtu:KiloW-HR ] ;
    edintalu:tariffPeriod <http://vocab.linkeddata.es/datosabiertos/kos/edint/TariffPeriod/valle> ;
    edintalu:fiscalYear "2024"^^xsd:gYear .

# --- Farola ---

ex:farola-001 a edintalu:Streetlight ;
    edintinf:hasInfrastructureType edintkosinftype:StreeLamp ;
    edintalu:controlCenter ex:cm-001 ;
    edintalu:post ex:post-001 ;
    edintalu:luminaire ex:lum-001 ;
    edintalu:junctionBox ex:junctionBox-001 ;
    edintinf:hasRegisteredOwner ex:ayto ;
    edintalu:hasFlowReducer ex:reductor-001 ;
    edintalu:illuminationClass <http://vocab.linkeddata.es/datosabiertos/kos/edint/IlluminationType/me4> ;
    edintalu:powerSupplyType <http://vocab.linkeddata.es/datosabiertos/kos/edint/PowerSupplyType/subterranea> ;
    edintalu:illuminationType <http://vocab.linkeddata.es/datosabiertos/kos/edint/IlluminationRegime/nocturna> ;
    edintalu:conservationStatus <http://vocab.linkeddata.es/datosabiertos/kos/edint/ConservationStatus/bueno> ;
    edintalu:lightingZone <http://vocab.linkeddata.es/datosabiertos/kos/edint/LightingZone/e3> ;
    edintalu:lightingClass <http://vocab.linkeddata.es/datosabiertos/kos/edint/LightingClass/b> ;
    edintalu:operatingHours "22:00-07:00" ;
    edintalu:controlMethod "Reloj astronómico" ;
    edintalu:address ex:dir-001 ;
    gsp:hasGeometry ex:geom-001 .

# --- Poste ---

ex:post-001 a edintalu:Post ;
    edintalu:supportType <http://vocab.linkeddata.es/datosabiertos/kos/edint/SupportType/baculo> ;
    edintalu:height [ a qudt:QuantityValue ; qudt:numericValue 8 ; qudt:hasUnit qudtu:M ] ;
    edintalu:numberOfArms 1 ;
    edintalu:hasArm ex:post-001-brazo1 ;
    edintalu:material "Acero galvanizado" ;
    edintalu:manufacturedBy ex:fabricante-postes .

ex:post-001-brazo1 a edintalu:Arm ;
    edintalu:armOrder 1 ;
    edintalu:height [ a qudt:QuantityValue ; qudt:numericValue 6.5 ; qudt:hasUnit qudtu:M ] .

# --- Luminaria ---

ex:lum-001 a edintalu:Luminaire ;
    edintalu:hasLamp ex:lamp-001 ;
    edintalu:luminaireModel ex:modelo-speedstar ;
    edintalu:luminaireType <http://vocab.linkeddata.es/datosabiertos/kos/edint/LuminaireType/viaria> ;
    edintalu:upperHemisphereFlux [ a qudt:QuantityValue ; qudt:numericValue 1 ; qudt:hasUnit qudtu:PERCENT ] ;
    edintalu:material "Aluminio inyectado" ;
    edintalu:manufacturedBy ex:fabricante-luminarias .

# --- Lámpara (LED con parámetros fotométricos) ---

ex:lamp-001 a edintalu:Lamp ;
    edintalu:lampType <http://vocab.linkeddata.es/datosabiertos/kos/edint/LampType/led> ;
    edintalu:nominalPower [ a qudt:QuantityValue ; qudt:numericValue 72 ; qudt:hasUnit qudtu:W ] ;
    edintalu:luminousFlux [ a qudt:QuantityValue ; qudt:numericValue 8600 ; qudt:hasUnit qudtu:LM ] ;
    edintalu:correlatedColorTemperature [ a qudt:QuantityValue ; qudt:numericValue 3000 ; qudt:hasUnit qudtu:K ] ;
    edintalu:colorRenderingIndex 70 ;
    edintalu:luminousEfficacy 119 ;
    edintalu:ratedLifeL70 [ a qudt:QuantityValue ; qudt:numericValue 100000 ; qudt:hasUnit qudtu:HR ] ;
    edintalu:installationDate "2024-03-15T00:00:00"^^xsd:dateTime .

# --- Caja de conexiones ---

ex:junctionBox-001 a edintalu:JunctionBox ;
    edintalu:cableType <http://vocab.linkeddata.es/datosabiertos/kos/edint/CableType/et106> ;
    edintalu:material "Policarbonato" .

# --- Reductor de flujo ---

ex:reductor-001 a edintalu:FlowReducer ;
    edintalu:hasLuminaireFlowReducer true ;
    edintalu:hasHeadEndFlowReducer false .

# --- Modelo de luminaria (catálogo) ---

ex:modelo-speedstar a edintalu:LuminaireModel ;
    edintalu:name "SpeedStar LED 72W" ;
    edintalu:manufacturedBy ex:fabricante-luminarias .

# --- Fabricantes ---

ex:fabricante-luminarias a edintalu:Manufacturer ;
    edintalu:name "Signify" .

ex:fabricante-postes a edintalu:Manufacturer ;
    edintalu:name "Valmont Industries" .

# --- Propietario ---

ex:ayto a edintinf:Organization ;
    edintalu:name "Ayuntamiento" .

# --- Dirección ---

ex:dir-001 a esdir:DireccionPostal ;
    schema:streetAddress "Calle Mayor 1" ;
    schema:addressLocality "Villaexample" ;
    schema:addressRegion "Provincia" ;
    schema:addressCountry "ES" .

# --- Geometría ---

ex:geom-001 a gsp:Geometry ;
    gsp:asWKT "POINT (-3.70 40.42)"^^gsp:wktLiteral .
