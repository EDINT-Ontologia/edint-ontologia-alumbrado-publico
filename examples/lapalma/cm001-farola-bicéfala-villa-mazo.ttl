@prefix exlp: <http://example.org/lapalma/alumbrado/> .
@prefix edintalu: <http://vocab.linkeddata.es/datosabiertos/def/urbanismo-infraestructuras/alumbrado-publico#> .
@prefix edintinf: <http://vocab.linkeddata.es/datosabiertos/def/urbanismo-infraestructuras/infraestructura#> .
@prefix edintkosinftype: <http://vocab.linkeddata.es/datosabiertos/kos/edint/InfrastructureType/> .
@prefix esdir: <http://vocab.linkeddata.es/datosabiertos/def/urbanismo-infraestructuras/direccion-postal#> .
@prefix gsp: <http://www.opengis.net/ont/geosparql#> .
@prefix schema: <http://schema.org/> .
@prefix qudt: <http://qudt.org/schema/qudt/> .
@prefix qudtu: <http://qudt.org/vocab/unit/> .
@prefix dct: <http://purl.org/dc/terms/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

# ============================================================================
# Ejemplo: Farola bicéfala en CM-001, Villa de Mazo, La Palma
# Fuente: Cabildo Insular de La Palma — Alumbrado y farolas (ejercicio 2014)
#         Registro OBJECTID=1001, Código=1001
#
# Demuestra: farola bicéfala (2 luminarias, 2 lámparas de tipo distinto),
#            direcciones separadas para CM y farola.
# ============================================================================

# --- Centro de mando CM-001 ---

exlp:cm-001 a edintalu:ControlCenter ;
    edintalu:name "CM-001" ;
    edintalu:notes "Pueblo Norte, Camino Judas"@es ;
    dct:spatial exlp:cm-001-dir .

exlp:cm-001-dir a esdir:DireccionPostal ;
    schema:streetAddress "Avenida Enrique Mederos" ;
    schema:addressLocality "Villa de Mazo" ;
    schema:addressRegion "Santa Cruz de Tenerife" ;
    schema:addressCountry "ES" .

# --- Farola bicéfala (2 luminarias) ---

exlp:f1001 a edintalu:Streetlight ;
    edintinf:hasInfrastructureType edintkosinftype:StreeLamp ;
    edintalu:controlCenter exlp:cm-001 ;
    edintalu:post exlp:f1001-poste ;
    edintalu:luminaire exlp:f1001-lum1 , exlp:f1001-lum2 ;
    edintalu:lightingClass <http://vocab.linkeddata.es/datosabiertos/kos/edint/LightingClass/a> ;
    edintalu:illuminationClass <http://vocab.linkeddata.es/datosabiertos/kos/edint/IlluminationType/me4> ;
    edintalu:powerSupplyType <http://vocab.linkeddata.es/datosabiertos/kos/edint/PowerSupplyType/subterranea> ;
    edintalu:illuminationType <http://vocab.linkeddata.es/datosabiertos/kos/edint/IlluminationRegime/nocturna> ;
    edintalu:operatingHours "Noche entera" ;
    edintalu:numberOfLuminaires 2 ;
    edintalu:dataQuality "B" ;
    edintalu:address exlp:f1001-dir ;
    gsp:hasGeometry exlp:f1001-geom .

exlp:f1001-dir a esdir:DireccionPostal ;
    schema:streetAddress "Callejon de Judas" ;
    schema:addressLocality "Villa de Mazo" ;
    schema:addressRegion "Santa Cruz de Tenerife" ;
    schema:addressCountry "ES" .

exlp:f1001-geom a gsp:Geometry ;
    gsp:asWKT "POINT (-17.7752 28.6058)"^^gsp:wktLiteral .

# --- Poste ---

exlp:f1001-poste a edintalu:Post ;
    edintalu:supportType <http://vocab.linkeddata.es/datosabiertos/kos/edint/SupportType/baculo> ;
    edintalu:height [ a qudt:QuantityValue ; qudt:numericValue 6 ; qudt:hasUnit qudtu:M ] .

# --- Luminaria 1 + Lámpara 1 (VSBP 55W) ---

exlp:f1001-lum1 a edintalu:Luminaire ;
    edintalu:luminaireType <http://vocab.linkeddata.es/datosabiertos/kos/edint/LuminaireType/viaria> ;
    edintalu:hasLamp exlp:f1001-lum1-lamp .

exlp:f1001-lum1-lamp a edintalu:Lamp ;
    edintalu:lampType <http://vocab.linkeddata.es/datosabiertos/kos/edint/LampType/vapor-sodio-baja-presion> ;
    edintalu:nominalPower [ a qudt:QuantityValue ; qudt:numericValue 55 ; qudt:hasUnit qudtu:W ] .

# --- Luminaria 2 + Lámpara 2 (VSAP 250W) ---

exlp:f1001-lum2 a edintalu:Luminaire ;
    edintalu:luminaireType <http://vocab.linkeddata.es/datosabiertos/kos/edint/LuminaireType/viaria> ;
    edintalu:hasLamp exlp:f1001-lum2-lamp .

exlp:f1001-lum2-lamp a edintalu:Lamp ;
    edintalu:lampType <http://vocab.linkeddata.es/datosabiertos/kos/edint/LampType/vapor-sodio-alta-presion> ;
    edintalu:nominalPower [ a qudt:QuantityValue ; qudt:numericValue 250 ; qudt:hasUnit qudtu:W ] .
