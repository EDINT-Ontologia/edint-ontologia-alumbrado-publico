@prefix exlp: <http://example.org/lapalma/alumbrado/> .
@prefix edintalu: <http://vocab.linkeddata.es/datosabiertos/def/urbanismo-infraestructuras/alumbrado-publico#> .
@prefix edintinf: <http://vocab.linkeddata.es/datosabiertos/def/urbanismo-infraestructuras/infraestructura#> .
@prefix edintsum: <http://vocab.linkeddata.es/datosabiertos/def/urbanismo-infraestructuras/suministro#> .
@prefix edintkosinftype: <http://vocab.linkeddata.es/datosabiertos/kos/edint/InfrastructureType/> .
@prefix esdir: <http://vocab.linkeddata.es/datosabiertos/def/urbanismo-infraestructuras/direccion-postal#> .
@prefix gsp: <http://www.opengis.net/ont/geosparql#> .
@prefix sosa: <http://www.w3.org/ns/sosa/> .
@prefix qudt: <http://qudt.org/schema/qudt/> .
@prefix qudtu: <http://qudt.org/vocab/unit/> .
@prefix schema: <http://schema.org/> .
@prefix dct: <http://purl.org/dc/terms/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

# ============================================================================
# Ejemplo: Centro de mando CM-022 con suministro eléctrico y consumo
# Fuente: Cabildo Insular de La Palma — Alumbrado y farolas (ejercicio 2014)
#         Centro Nº_de_cent=CM-022, 8 farolas asociadas
#
# Demuestra: CentroDeMando con SuministroElectrico y ConsumoEnergetico (SOSA),
#            múltiples farolas asociadas al mismo CM.
# ============================================================================

# --- Centro de mando CM-022 ---

exlp:cm-022 a edintalu:ControlCenter ;
    edintalu:name "CM-022" ;
    edintalu:notes "San Antonio, El Monte"@es ;
    dct:spatial exlp:cm-022-dir ;
    edintalu:hasSupply exlp:cm-022-suministro .

exlp:cm-022-dir a esdir:DireccionPostal ;
    schema:streetAddress "Carretera San Antonio" ;
    schema:addressLocality "Villa de Mazo" ;
    schema:addressRegion "Santa Cruz de Tenerife" ;
    schema:addressCountry "ES" .

# --- Suministro eléctrico ---

exlp:cm-022-suministro a edintalu:ElectricitySupply ;
    edintalu:fiscalYear "2014"^^xsd:gYear ;
    edintalu:tariff "6.1" ;
    edintalu:hasConsumption exlp:cm-022-consumo2014 .

# --- Consumo energético (SOSA observation) ---

exlp:cm-022-consumo2014 a edintalu:EnergyConsumption ;
    sosa:hasFeatureOfInterest exlp:cm-022 ;
    sosa:observedProperty edintsum:electricityConsumption ;
    sosa:hasResult [ a qudt:QuantityValue ;
                     qudt:numericValue 4520 ;
                     qudt:hasUnit qudtu:KiloW-HR ] ;
    edintalu:tariffPeriod <http://vocab.linkeddata.es/datosabiertos/kos/edint/TariffPeriod/llano> ;
    edintalu:fiscalYear "2014"^^xsd:gYear .

# --- Farolas del CM-022 (muestra de 2) ---

exlp:f2201 a edintalu:Streetlight ;
    edintinf:hasInfrastructureType edintkosinftype:StreeLamp ;
    edintalu:controlCenter exlp:cm-022 ;
    edintalu:post exlp:f2201-poste ;
    edintalu:luminaire exlp:f2201-lum1 ;
    edintalu:illuminationClass <http://vocab.linkeddata.es/datosabiertos/kos/edint/IlluminationType/s4> ;
    edintalu:powerSupplyType <http://vocab.linkeddata.es/datosabiertos/kos/edint/PowerSupplyType/aerea> ;
    edintalu:illuminationType <http://vocab.linkeddata.es/datosabiertos/kos/edint/IlluminationRegime/nocturna> ;
    edintalu:dataQuality "R" ;
    edintalu:address exlp:f2201-dir ;
    gsp:hasGeometry exlp:f2201-geom .

exlp:f2201-dir a esdir:DireccionPostal ;
    schema:streetAddress "Calle San Antonio 15" ;
    schema:addressLocality "Villa de Mazo" ;
    schema:addressRegion "Santa Cruz de Tenerife" ;
    schema:addressCountry "ES" .

exlp:f2201-geom a gsp:Geometry ;
    gsp:asWKT "POINT (-17.7690 28.6120)"^^gsp:wktLiteral .

exlp:f2201-poste a edintalu:Post ;
    edintalu:supportType <http://vocab.linkeddata.es/datosabiertos/kos/edint/SupportType/baculo> ;
    edintalu:height [ a qudt:QuantityValue ; qudt:numericValue 4 ; qudt:hasUnit qudtu:M ] .

exlp:f2201-lum1 a edintalu:Luminaire ;
    edintalu:luminaireType <http://vocab.linkeddata.es/datosabiertos/kos/edint/LuminaireType/viaria> ;
    edintalu:hasLamp exlp:f2201-lum1-lamp .

exlp:f2201-lum1-lamp a edintalu:Lamp ;
    edintalu:lampType <http://vocab.linkeddata.es/datosabiertos/kos/edint/LampType/vapor-sodio-alta-presion> ;
    edintalu:nominalPower [ a qudt:QuantityValue ; qudt:numericValue 150 ; qudt:hasUnit qudtu:W ] .
