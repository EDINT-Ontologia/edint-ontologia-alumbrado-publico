@prefix exlp: <http://example.org/lapalma/alumbrado/> .
@prefix edintalu: <http://vocab.linkeddata.es/datosabiertos/def/urbanismo-infraestructuras/alumbrado-publico#> .
@prefix edintinf: <http://vocab.linkeddata.es/datosabiertos/def/urbanismo-infraestructuras/infraestructura#> .
@prefix edintkosinftype: <http://vocab.linkeddata.es/datosabiertos/kos/edint/InfrastructureType/> .
@prefix esdir: <http://vocab.linkeddata.es/datosabiertos/def/urbanismo-infraestructuras/direccion-postal#> .
@prefix gsp: <http://www.opengis.net/ont/geosparql#> .
@prefix schema: <http://schema.org/> .
@prefix qudt: <http://qudt.org/schema/qudt/> .
@prefix qudtu: <http://qudt.org/vocab/unit/> .
@prefix dct: <http://purl.org/dc/terms/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

# ============================================================================
# Ejemplo: Farola simple en CM-001, Villa de Mazo, La Palma
# Fuente: Cabildo Insular de La Palma — Alumbrado y farolas (ejercicio 2014)
#         Registro OBJECTID=1002, Código=1002
#
# Demuestra: farola simple (1 luminaria, 1 lámpara LED),
#            tipo de soporte báculo.
# ============================================================================

# --- Centro de mando CM-001 ---

exlp:cm-001 a edintalu:ControlCenter ;
    edintalu:name "CM-001" ;
    dct:spatial exlp:cm-001-loc .

exlp:cm-001-loc a esdir:DireccionPostal ;
    schema:streetAddress "Avenida Enrique Mederos" ;
    schema:addressLocality "Villa de Mazo" ;
    schema:addressRegion "Santa Cruz de Tenerife" ;
    schema:addressCountry "ES" .

# --- Farola simple (1 luminaria) ---

exlp:f1002 a edintalu:Streetlight ;
    edintinf:hasInfrastructureType edintkosinftype:StreeLamp ;
    edintalu:controlCenter exlp:cm-001 ;
    edintalu:post exlp:f1002-poste ;
    edintalu:luminaire exlp:f1002-lum1 ;
    edintalu:lightingClass <http://vocab.linkeddata.es/datosabiertos/kos/edint/LightingClass/c> ;
    edintalu:illuminationClass <http://vocab.linkeddata.es/datosabiertos/kos/edint/IlluminationType/s3> ;
    edintalu:powerSupplyType <http://vocab.linkeddata.es/datosabiertos/kos/edint/PowerSupplyType/subterranea> ;
    edintalu:illuminationType <http://vocab.linkeddata.es/datosabiertos/kos/edint/IlluminationRegime/nocturna> ;
    edintalu:operatingHours "Noche entera" ;
    edintalu:numberOfLuminaires 1 ;
    edintalu:dataQuality "B" ;
    edintalu:address exlp:f1002-dir ;
    gsp:hasGeometry exlp:f1002-geom .

exlp:f1002-dir a esdir:DireccionPostal ;
    schema:streetAddress "Calle El Roque" ;
    schema:addressLocality "Villa de Mazo" ;
    schema:addressRegion "Santa Cruz de Tenerife" ;
    schema:addressCountry "ES" .

exlp:f1002-geom a gsp:Geometry ;
    gsp:asWKT "POINT (-17.7750 28.6060)"^^gsp:wktLiteral .

# --- Poste ---

exlp:f1002-poste a edintalu:Post ;
    edintalu:supportType <http://vocab.linkeddata.es/datosabiertos/kos/edint/SupportType/baculo> ;
    edintalu:height [ a qudt:QuantityValue ; qudt:numericValue 5 ; qudt:hasUnit qudtu:M ] .

# --- Luminaria + Lámpara (LED 80W) ---

exlp:f1002-lum1 a edintalu:Luminaire ;
    edintalu:luminaireType <http://vocab.linkeddata.es/datosabiertos/kos/edint/LuminaireType/viaria> ;
    edintalu:hasLamp exlp:f1002-lum1-lamp .

exlp:f1002-lum1-lamp a edintalu:Lamp ;
    edintalu:lampType <http://vocab.linkeddata.es/datosabiertos/kos/edint/LampType/led> ;
    edintalu:nominalPower [ a qudt:QuantityValue ; qudt:numericValue 80 ; qudt:hasUnit qudtu:W ] ;
    edintalu:correlatedColorTemperature [ a qudt:QuantityValue ; qudt:numericValue 4000 ; qudt:hasUnit qudtu:K ] ;
    edintalu:colorRenderingIndex 80 .
